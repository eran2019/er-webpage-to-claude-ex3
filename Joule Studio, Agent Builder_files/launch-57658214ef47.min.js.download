(/[\\[\\]]/g, '\\\\$&');\n\t\tvar regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),\n\t\t\tresults = regex.exec(url);\n\t\tif (!results) return null;\n\t\tif (!results[2]) return '';\n\t\treturn decodeURIComponent(results[2].replace(/\\+/g, ' '));\n\t};\n\tvar getATName = function(bbKey){\n\t\tvar name, _bbKey_ = String(bbKey).trim();\n\t\tif (knownParams.indexOf(_bbKey_) !== -1) {\n\t\t\tname = 'bombora_' + _bbKey_;\n\t\t} else {\n\t\t\t_satellite.logger.warn('Bombora: unknown key ' + _bbKey_);\n\t\t}\n\t\treturn name;\n\t};\n\tvar buildProfileAttributes = function(data){\n\t\tvar result = {};\n\t\tvar attrVal;\n\t\tfor (var p in data) {\n\t\t\tvar atName = getATName(p);\n\t\t\tif (atName) {\n\t\t\t\tif (data[p] instanceof Array) {\n\t\t\t\t\tattrVal = '|' + data[p].join('|') + '|';\n\t\t\t\t} else {\n\t\t\t\t\tattrVal = data[p];\n\t\t\t\t}\n\t\t\t\tif (attrVal.length < 256) {\n\t\t\t\t\tresult[atName] = attrVal;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn result;\n\t};\n\tvar getProfileAttributes = function() {\n\t\tvar result = {}, data;\n\t\tvar spoofData = getParameterByName('bombora');\n\t\tif (spoofData) {\n\t\t\ttry {\n\t\t\t\tdata = JSON.parse(spoofData);\n\t\t\t\tresult = buildProfileAttributes(data);\n\t\t\t} catch (e){\n\t\t\t\tconsole.error('Bombora: ' + e.message);\n\t\t\t}\n\t\t} else {\n\t\t\tdata = JSON.parse(localStorage.getItem(lsName)) || false;\n\t\t\tif (data && data.details) {\n\t\t\t\tresult = buildProfileAttributes(data.details);\n\t\t\t}\n\t\t}\n\t\treturn result;\n\t};\n\n\tvar setBomboraParams = function() {\n\t\tvar bmb_attrs = getProfileAttributes();\n\t\twindow.targetPageParamsObj.profile = Object.assign(bmb_attrs, window.targetPageParamsObj.profile);\n\t};\n\n\tvar dataProvider = {\n\t\tname: \"bombora\",\n\t\tversion: \"1.0.0\",\n\t\ttimeout: 2000, // In case the Bombora service is unavailable\n\t\tprovider: function (callback) {\n\t\t\tvar cache = localStorage.getItem(lsName) || false;\n\t\t\tif (!cache) {\n\t\t\t\tif (window.SAP.