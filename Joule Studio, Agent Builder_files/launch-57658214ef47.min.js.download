        en: {\n                "store": _satellite.getVar("Target - URLs 7981"),\n                "products": _satellite.getVar("Target - URLs 7969")\n            }\n        };\n\n        const matchingPages = {};\n\n        Object.keys(pagesMerged).forEach(lang => {\n            if (checkLang(lang)) {\n                Object.keys(pagesMerged[lang]).forEach(pages => {\n                    const matchingPage = pagesMerged[lang][pages].find(page => h === page[0] + page[1]);\n                    if (matchingPage) {\n                        matchingPages[lang] = matchingPages[lang] || {};\n                        matchingPages[lang][pages] = matchingPage;\n                    }\n                });\n            }\n        });\n\n        if (Object.keys(matchingPages).length === 0) {\n            _satellite.logger.log(\'[EDS Recs] Entity values not sent - no matching pages found for current URL:\', h);\n            callback();\n            return;\n        }\n\n        let entityName = "Target - entity.name";\n\n        onValueReady(function () {\n            return _satellite.getVar(entityName);\n        }, function () {\n            Object.keys(matchingPages).forEach(lang => {\n                Object.keys(matchingPages[lang]).forEach(page => {\n                    const matchingPage = matchingPages[lang][page];\n                    let entityId = _satellite.getVar("Target - entity.id");\n                    if (!!entityId) {\n                        let pageUrl = _satellite.getVar("Target - entity.PageUrl");\n                        if (pageUrl.indexOf("assetdetail") === -1 &&\n                            pageUrl.indexOf("documents") === -1) {\n                            entityParams["entity.id"] = entityId;\n                            if (!!matchingPage[2]) {\n                                entityParams["entity.PageUrl2"] = entityParams["entity.PageUrl2"] ||\n                                    location.origin + matchingPage[0] + matchingPage[2];\n                            }\n                            entityParams["entity.message"] = entityParams["entity.message"] ||\n                                _satellite.getVar("Target - entity.message");\n                            entityParams["entity.name"] = entityParams["entity.name"] ||\n                                _satellite.getVar(entityName);\n                            let logoUrl = _satellite.getVar("Target - entity.logoUrl");\n                            if (!!logoUrl && !entityParams["entity.logoUrl"]) {\n                                entityParams["entity.logoUrl"] = logoUrl;\n                                entityParams["entity.logoText"] = _satellite.getVar("Target - entity.logoText");\n                            }\n                            entityParams["entity.PageUrl"] = entityParams["entity.PageUrl"] || pageUrl;\n                            entityParams["entity.domain"] = entityParams["entity.domain"] || "|";\n                            entityParams["entity.domain"] += page + "|";\n                        } else {\n                            _satellite.logger.log(\'[EDS Recs] Entity values not sent - excluded page type:\', {\n                                pageUrl: pageUrl,\n                                reason: \'assetdetail or documents page\'\n                            });\n                        }\n                    }\n                });\n            });\n            if (Object.keys(entityParams).length > 0) {\n                window.SAP = window.SAP || {};\n                window.SAP.p13n = window.SAP.p13n || {};\n                window.SAP.p13n.entity = entityParams;\n                callback(entityParams);\n                return;\n            }\n            _satellite.logger.log(\'[EDS Recs] Entity values not sent - no entity parameters collected\');\n            callback(null);\n        },function(){\n            _satellite.logger.log(\'[EDS Recs] Entity values not sent - timeout waiting for entity.name data element\');\n            callback(null);\n        });\n    }\n\n    function hasHeroModifyingActions() {\n        try {\n            const offers = window.SAP?.p13n?.response?.offers;\n            if (!offers || !Array.isArray(offers) || offers.length === 0) {\n                return false;\n            }\n\n            const heroKeywords = [\n                \'heroFixedHeight\',\n                \'heroFlex\',\n                \'hero-v2-container\',\n                \'hero__content\',\n                \'product-hero-wrapper\'\n            ];\n\n            for (let i = 0; i < offers.length; i++) {\n                const offer = offers[i];\n\n                if (offer.action === \'trackClick\') {\n                    continue;\n                }\n\n                const textToCheck = [\n                    offer.content || \'\'\n                ].join(\' \');\n\n                for (let j = 0; j < heroKeywords.length; j++) {\n                    const keyword = heroKeywords[j];\n                    if (textToCheck.toLowerCase().includes(keyword.toLowerCase())) {\n                        _satellite.logger.log(\'[EDS Recs] Entity values not sent - hero banner modification detected:\', {\n                            action: offer.action,\n                            keyword: keyword,\n                            selector: offer.selector || offer.cssSelector,\n                            offerIndex: i\n                        });\n                        return true;\n                    }\n                }\n            }\n\n            return false;\n        } catch (e) {\n            _satellite.logger.log(\'[EDS Recs] Error checking hero modifications:\', e);\n            return false;\n        }\n    }\n\n    let callback = function(entity) {\n        if (!hasHeroModifyingActions() && entity) {\n            let params = entity;\n            adobe.target.trackEvent({\n                mbox: "mboxProductView",\n                params\n            });\n            _satellite.logger.log(\'[EDS Recs] Entity values sent successfully to mboxProductView:\', params);\n        }\n    };\n\n    document.addEventListener("global-mbox-request-fired", function() {\n        let isEdgeBrowserAsync = _satellite.getVar("Target - isEdgeBrowserAsync");\n        if (window.adobe && adobe.target && typeof adobe.target.trackEvent === "function") {\n            if (!isEdgeBrowserAsync) {\n                scrapeEntityValues(callback);\n            } else {\n                (async () => {\n                    if (!(await isEdgeBrowserAsync())) {\n                        scrapeEntityValues(callback);\n                    } else {\n                        _satellite.logger.log(\'[EDS Recs] Entity values not sent - Edge browser async mode\');\n                    }\n                })();\n            }\n        } else {\n            _satellite.logger.log(\'[EDS Recs] Entity values not sent - adobe.target.trackEvent not available\');\n        }\n    });\n})();',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLb8168afb047a481b8c2dd1e86b156d51",name:"DL - AA - Ecommerce - Cart Create [SET+30]",events:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/events/datalayerPushListener.js",settings:{scope:"all",method:"specificEvent",eventKey:"cartCreate"},ruleOrder:30}],conditions:[],actions:[{modulePath:"adobe-analytics/src/lib/actions/setVariables.js",settings:{trackerProperties:{events:[{id:"%DL - ecommerce.cart.id%",name:"scOpen"}]}},timeout:2e3,delayNext:!0}]},{id:"RLb848fdc860e440fba5df5803f712285c",name:"DL - AA - Ecommerce - Cart Add [SET+30]",events:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/events/datalayerPushListener.js",settings:{scope:"all",method:"specificEvent",eventKey:"cartAdd"},ruleOrder:30}],conditions:[],actions:[{modulePath:"aa-product-string-search-discovery/src/lib/actions/product_string_set_variables.js",settings:{dataLayerRoot:"%DL - _computedState%",productStringEvars:[],productStringEvents:[{eventId:"event14",eventPath:"price",isBooleanFlag:!1}],