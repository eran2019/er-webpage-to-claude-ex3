Event",eventKey:"cartRemove"},ruleOrder:30}],conditions:[],actions:[{modulePath:"aa-product-string-search-discovery/src/lib/actions/product_string_set_variables.js",settings:{dataLayerRoot:"%DL - _computedState%",productStringEvars:[],productStringEvents:[{eventId:"event14",eventPath:"price",isBooleanFlag:!1}],productCollectionPath:"ecommerce.products",productStringCategory:"category",productStringQuantity:"quantity",productStringUnitPrice:"price",productStringProductIdPath:"id",productStringCategorySelected:!1,productStringQuantitySelected:!1,productStringProductIdSelected:!0,productStringUnitPriceSelected:!1,productStringCategoryVariableType:"collection-item-path",productStringQuantityVariableType:"collection-item-path",productStringProductIdVariableType:"collection-item-path",productStringUnitPriceVariableType:"collection-item-path",resetProductStringBeforeApplication:!0},timeout:2e3,delayNext:!0},{modulePath:"adobe-analytics/src/lib/actions/setVariables.js",settings:{trackerProperties:{events:[{name:"scRemove"}]}},timeout:2e3,delayNext:!0}]},{id:"RLd8f3f4d807ea4a2ba4d31a7d15f12098",name:"Target Flicker Control (EDS) [PAGE_TOP+0,setUserConsent+0]",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:0},{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"setUserConsent",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:0}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:".*mboxDisable=(true|1).*",valueIsRegex:!0}]},negate:!0,timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){try{return _satellite.getVar("isConsentEnabled")("omtrdc.net",1)}catch(e){_satellite.notify(e.message,5)}return!1}},timeout:0},{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/store.html$",valueIsRegex:!0},{value:"/research/five-ways-that-ai-is-changing-finance$",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(e){return"setUserConsent"!==e.nativeEvent?.type||window.SAP?.p13n?.consentHandleMode||(window.SAP=window.SAP||{},window.SAP.p13n=window.SAP.p13n||{},window.SAP.p13n.consentHandleMode=!0),!0}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,
source:"((win, doc, cssClasses) => {\n    'use strict';\n\n    let hidingStyle = cssClasses + ' {opacity: 0 !important}';\n    \n    if (performance && performance.mark) {\n      performance.mark('flickerLaunchRuleStart');\n    }\n\n    const GLOBAL_DEFAULT_STYLE_ID = 'at-global-flicker-control';\n    // Launch below the fold\n    const AEM_LBF_PREHIDE_STYLE_ID = 'mbox-default-style'; /*SAPONEDX-36980,SAPONEDX-37049*/\n\n    /* this timeout value should be not less than at.js timeout*/\n    const CUSTOM_ADOBE_TARGET_FALLBACK_TIMEOUT = 3000;\n    const POSTPONED_RENDERING_STATUS_CHECK_ATTEMPTS = 20;\n    const sapGlobalMbox = 'sap_global_target';\n  \n    let isContentHidden = false;\n  \n    const log = (msg) => {\n      _satellite.logger.log('[Flicker Control] => ' + msg);\n    };\n\n    const getHead = () => {\n       return doc.getElementsByTagName('head')[0];\n    };\n  \n    const addStyle = (parent, id, def) => {\n      if (!parent) {\n        return;\n      }\n      log('Applying styles: ' + def + ' Time: ' + getTime());\n      const style = doc.createElement('style');\n      style.id = id;\n      style.innerHTML = def;\n      parent.appendChild(style);\n    };\n\n    const getTime = () => {\n      const formatter = (value, targetLen) => {\n        while (value.toString().length < targetLen) { value = \"0\" + value; } return value;\n      };\n      const today = new Date();\n      return formatter(today.getHours(),2) + ':' + formatter(today.getMinutes(),2) + ':' + formatter(today.getSeconds(),2) + ':' + formatter(today.getMilliseconds(),3);\n    };\n\n    const isAemHidingEnabled = () => {\n        return !!window.SAP?.p13n?.aemHiding;\n    };\n\n    const shouldConsentPromptBeHandled = () => {\n        return !!window.SAP?.p13n?.consentHandleMode;\n    };\n\n    const removePrehide = () => {\n      const g = document.getElementsByTagName(\"head\")[0];\n      const h = document.getElementById(AEM_LBF_PREHIDE_STYLE_ID);\n\n      if (!g || !h) {\n        return;\n      }\n      g.removeChild(h)\n    };\n\n    const removeStyle = (parent, id) => {\n      if (!!parent) {\n        const style = doc.getElementById(id);\n        if (!style) {\n          return;\n        }\n        log('Styles removed. id = ' + id + ', Time: ' + getTime());\n        parent.removeChild(style);\n      }\n    };\n\n    const getMboxName = (e) => {\n        let result = sapGlobalMbox;\n        if (e.detail.mbox) {\n            result = e.detail.mbox;\n        } else if (e.detail.error) {\n            if (!!e.detail.error.length && !!e.detail.error[0].mbox) {\n                result = e.detail.error[0].mbox;\n            }\n        }\n        return result;\n    };\n\n    const hideContent = () => {\n        if (!shouldConsentPromptBeHandled()) {\n            isContentHidden = true;\n            addStyle(getHead(), GLOBAL_DEFAULT_STYLE_ID, hidingStyle);\n            removePrehide();\n            /* fallback if no at.js events were noticed*/\n            win.setTimeout(() => {\n                showContent();\n            }, CUSTOM_ADOBE_TARGET_FALLBACK_TIMEOUT);\n        }\n    };\n\n    const showContent = () => {\n      if (!shouldConsentPromptBeHandled()) {\n        if (isContentHidden) {\n            isContentHidden = false;\n            log('Removing all hiding styles... , Time: ' + getTime());\n            delete window.TARGET_CONTENT_RENDERING_POSTPONED;\n            removeStyle(getHead(), AEM_LBF_PREHIDE_STYLE_ID);\n            removeStyle(getHead(), GLOBAL_DEFAULT_STYLE_ID);\n        }\n      }\n      delete window.TARGET_CONTENT_RENDERING_POSTPONED;\n    };\n\n    const isLbfPage = () => {\n      return !document.querySelectorAll('head script[src*=launch]').length;\n    };\n\n    const installEventListeners = () => {\n        /*\n        at this moment, the Target library has not been loaded because this script executes before.\n        As a result, the values from adobe.target.event.* are not available\n        */\n\n        // request handlers\n        doc.addEventListener('at-request-succeeded', (e) => {\n          log('REQUEST_SUCCEEDED. Mbox: [' + getMboxName(e) + ']');\n        });\n\n        doc.addEventListener('at-request-failed', (e) => {\n            log('REQUEST_FAILED. Error: [' + (e.detail.error ? e.detail.error.message : undefined) + ']. Mbox: [' + getMboxName(e) + ']');\n            if (getMboxName(e) === sapGlobalMbox) {\n                showContent();\n            }\n        });\n\n        /* content rendering handlers*/\n        doc.addEventListener('at-content-rendering-succeeded', (e) => {\n            log('CONTENT_RENDERING_SUCCEEDED. Mbox: [' + getMboxName(e) + ']');\n            if (getMboxName(e) === sapGlobalMbox) {\n                /*\n                activity JS scripts can set TARGET_CONTENT_RENDERING_POSTPONED flag and clear it when DOM is ready\n                */\n                if (window.TARGET_CONTENT_RENDERING_POSTPONED) {\n                    log('TARGET_CONTENT_RENDERING_POSTPONED. Mbox: [' + getMboxName(e) + ']');\n                    let checkNum = 0;\n                    const checkHandler = setInterval(() => {\n                        log('Checking content rendereding status. Mbox: [' + getMboxName(e) + ']');\n                        ++checkNum;\n                        if (!window.TARGET_CONTENT_RENDERING_POSTPONED ||\n                            checkNum >= POSTPONED_RENDERING_STATUS_CHECK_ATTEMPTS) {\n                            showContent();\n                            clearInterval(checkHandler);\n                            if (window.TARGET_CONTENT_RENDERING_POSTPONED) {\n                                log('TARGET_CONTENT_RENDERING_POSTPONED was forcibly removed');\n                                delete window.TARGET_CONTENT_RENDERING_POSTPONED;\n                            }\n                        }\n                    }, 100);\n                } else {\n                    showContent();\n                }\n            }\n        });\n\n        doc.addEventListener('at-content-rendering-no-offers', (e) => {\n            log('AT_CONTENT_RENDERING_NO_OFFERS. Mbox: [' + getMboxName(e) + ']');\n            if (getMboxName(e) === sapGlobalMbox) {\n                showContent();\n            }\n        });\n\n        doc.addEventListener('at-content-rendering-failed', (e) => {\n            log('AT_CONTENT_RENDERING_FAILED. Mbox: [' + getMboxName(e) + ']');\n            showContent();\n        });  \n    };\n\n    const init = () => {\n        if (!shouldConsentPromptBeHandled() &&\n            isAemHidingEnabled() &&\n            isLbfPage() &&\n            !doc.getElementById(AEM_LBF_PREHIDE_STYLE_ID)) {\n            log('Cancelled. Low performance: ' +\n                (performance.getEntriesByName(\"flickerLaunchRuleStart\")[0].startTime - performance.getEntriesByName(\"mbtfAemHidingSet\")[0].startTime));\n            return;\n        }\n\n        installEventListeners();\n\n        hideContent();\n    };\n\n    init();\n  \n  })(window, document, '.promo-container.collection-container .promo-wrapper:nth-child(1),.hlx-main .merchandising-dynamic-container:nth-child(1)');\n",language:"javascript"},timeout:10,delayNext:!0}]},{id:"RLd91463a340b1476e8af9a1ee3773632d",name:"DL - AA - s.t() Send Beacon - Pageview [TRIGGER+50]",events:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/events/datalayerPushListener.js",settings:{scope:"all",method:"specificEvent",eventKey:"stBeaconReady"},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-analytics/src/lib/actions/setVariables.js",settings:{customSetup:{source:function(){try{var e;window.isConsentEnabled("omtrdc.net",1)&&((e=JSON.parse(_satellite.getVar("trustarc_referrer"))||{}).isConsumed=!0,sessionStorage.setItem("trustarc_referrer",JSON.stringify(e)))}catch(e){}}},trackerProperties:{eVars:[{name:"eVar18",type:"value",value:"+1"},{name:"eVar153",type:"value",value:"%x. AA - v153%"}]}},timeout:2e3,delayNext:!0},{modulePath:"adobe-analytics/src/lib/actions/sendBeacon.js",settings:{type:"page"},timeout:2e3,delayNext:!0},{modulePath:"adobe-analytics/src/lib/actions/clearVariables.js",settings:{},timeout:2e3,delayNext:!0}]},{id:"RLdc3f7aa8920a4786b04d09aeb312c1d3",name:"02_02 Target (1DX) - Load Target - Mbox Create [PAGE_TOP+30,setUserConsent+30]",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:30},{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"setUserConsent",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:30}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){return(_satellite.getVar("targetConfig")||{target:!1}).target}},timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){try{return window.isConsentEnabled("omtrdc.net",1)}catch(e){_satellite.notify(e.message,5)}return!1}},timeout:2e3},{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"^\\/community(\\/|\\.html)",valueIsRegex:!0},{value:"^\\/dmc\\/",valueIsRegex:!0}]},negate:!0,timeout:2e3}],actions:[{modulePath:"adobe-target-v2/lib/loadTarget.js",settings:{},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,source:"window.fireGlobalMboxRequest = function() {\n\t_satellite.logger.log(\"fireGlobalMboxRequest function fired\");\n\ttry {\n\t\tvar globalMboxName = 'sap_global_target';\n      \n\t\tvar requestFiredEvent = document.createEvent('CustomEvent');\n\t\tvar requestFiredEventName = 'global-mbox-request-fired';\n      \n        const setMinHeight = (event) => {\n          if (!event) {\n            return;\n          }\n\n          const selector =\n            event.detail?.find(({ action }) => action === 'setContent')?.selector || '';\n\n          if (!selector) {\n            return;\n          }\n\n          const targetElement = document.querySelector(selector);\n\n          if (targetElement) {\n            targetElement.style.minHeight = `${targetElement.offsetHeight}px`;\n          }\n        };\n      \n\t\tlet getOffer = function(callback){\n\t\t\tadobe.target.getOffer({\n\t\t\t\tmbox: globalMboxName,\n                consumerId: globalMboxName + \",\" + window.SAP.p13n.clickTracker.consumerId,\n\t\t\t\tsuccess: function(offer) {\n\t\t\t\t\twindow.__personalizationObserver__.dispatch({detail: offer});\n\t\t\t\t\tsetMinHeight({detail: offer}); // TODO: test height setup for EDS\n\n                    offer = window.SAP.p13n.clickTracker.delegateToOffers(offer);\n                  \n\t\t\t\t\tadobe.target.applyOffer({\n\t\t\t\t\t\tmbox: globalMboxName,\n\t\t\t\t\t\toffer: offer\n\t\t\t\t\t});\n\n\t\t\t\t\tif(document.readyState !== \"loading\" && typeof window.picturefill === 'function') {\n\t\t\t\t\t\twindow.picturefill();\n\t\t\t\t\t}\n\n\t\t\t\t\trequestFiredEvent.initCustomEvent(requestFiredEventName, true, true, offer);\n\t\t\t\t\tdocument.dispatchEvent(requestFiredEvent);\n\n\t\t\t\t\tcallback && callback();\n\t\t\t\t},\n\t\t\t\terror: function(status, error) {\n\t\t\t\t\t_satellite.logger.error('Target error:' + status + ' ' + error);\n\t\t\t\t\trequestFiredEvent.initCustomEvent(requestFiredEventName, true, true, {});\n\t\t\t\t\tdocument.dispatchEvent(requestFiredEvent);\n\t\t\t\t\tcallback && callback();\n\t\t\t\t},\n\t\t\t\ttimeout: function() {\n\t\t\t\t\tconsole.log('Adobe Target Timeout');\n\t\t\t\t\trequestFiredEvent.initCustomEvent(requestFiredEventName, true, true, {});\n\t\t\t\t\tdocument.dispatchEvent(requestFiredEvent);\n\t\t\t\t\tcallback && callback();\n\t\t\t\t}\n\t\t\t});\n\t\t};\n\n\t\tif(typeof adobe === 'object' && typeof adobe.target === 'object') {\n\t\t\tif (window.SAP?.p13n?.\u0441onsentHandleMode) {\n\t\t\t\tconst adobeTargetPromise = new Promise((resolve)=> {\n\t\t\t\t\tgetOffer(function() {\n\t\t\t\t\t\tresolve();\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t\twindow.SAP?.asyncDataProviders?.promises?.push?.(adobeTargetPromise);\n\t\t\t} else {\n\t\t\t\tgetOffer();\n\t\t\t}\n\t\t} else {\n\t\t\t_satellite.logger.log('Target library not loaded');\n\t\t}\n\t} catch(e) {\n\t\t_satellite.logger.error(e.message);\n\t}\n};",language:"javascript"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,source:'(function() {\n\n\t/* Debugging Activity information */\n\twindow.sap_target_activities = [];\n\tdocument.addEventListener(adobe.target.event.REQUEST_SUCCEEDED, function(e) {\n\t\tvar tokens = e.detail.responseTokens;\n\t\tif (tokens !== null && typeof tokens === \'object\') {\n\t\t\ttokens.forEach(function(token) {\n\t\t\t\tvar info = {\n\t\t\t\t\t"campaign": {\n\t\t\t\t\t\t"id": token["activity.id"],\n\t\t\t\t\t\t"name": token["activity.name"]\n\t\t\t\t\t},\n\t\t\t\t\t"experience": {\n\t\t\t\t\t\t"id": token["experience.name"],\n\t\t\t\t\t\t"name": token["experience.name"]\n\t\t\t\t\t},\n\t\t\t\t\t"offer": {\n\t\t\t\t\t\t"id": token["option.id"],\n\t\t\t\t\t\t"name": token["option.name"]\n\t\t\t\t\t},\n\t\t\t\t\t"mbox": e.detail.mbox\n\t\t\t\t};\n\n\t\t\t\twindow.sap_target_activities.push(info);\n\t\t\t\t_satellite.logger.log(\'Target Activity: \' + JSON.stringify(info, null, "\\t"));\n\t\t\t});\n\t\t}\n\t});\n\n\tvar createTargetProfileObject = function(){\n\t\twindow.targetPageParamsObj = window.targetPageParamsObj ? window.targetPageParamsObj : {};\n\t\twindow.targetPageParamsObj.profile = window.targetPageParamsObj.profile ? window.targetPageParamsObj.profile : {};\n\t};createTargetProfileObject();\n\n\tvar config = _satellite.getVar("targetConfig");\n\tif(typeof config.globalParams === "object" && config.globalParams !== null) {\n\t\twindow.targetPageParamsObj = Object.assign(config.globalParams, window.targetPageParamsObj);\n\t}\n\twindow.targetPageParamsAll = function() {\n\t\treturn window.targetPageParamsObj || {};\n\t};\n\n    var priorityResolver = (function(){\n\t\tconst DELAY_MS = 50;\n\t\tconst scripts = {};\n\t\tlet initialized = false;\n\t\tconst init = () => {\n\t\t\tsetTimeout(() => {\n\t\t\t\tfor (const key in scripts) {\n\t\t\t\t\tscripts[key]();\n\t\t\t\t}\n\t\t\t}, DELAY_MS);\n\t\t};\n\t\tconst registerForId = (id, callback, label) => {\n\t\t\tif (!initialized) {\n\t\t\t\tinit();\n\t\t\t\tinitialized = true;\n\t\t\t}\n\t\t\tscripts[id] = () => {\n\t\t\t\tif (label) {\n\t\t\t\t\tconst el = document.querySelector(`.${id}`);\n\t\t\t\t\tif (el) {\n\t\t\t\t\t\tel.classList.add(label);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif (callback) callback(id);\n\t\t\t};\n\t\t};\n\t\treturn {\n\t\t\taddScript: registerForId\n\t\t};\n\t})();\n  \n\twindow.adobe = window.adobe || {};\n\twindow.adobe.target = window.adobe.target || {};\n\twindow.adobe.target.sap = window.adobe.target.sap || {};\n\twindow.adobe.target.sap.scriptPriorityResolver = priorityResolver;\n  \n    window.SAP = window.SAP || {};\n    window.SAP.p13n = window.SAP.p13n || {};\n    window.SAP.p13n.scriptPriorityResolver = priorityResolver;\n\n    window.SAP.p13n.clickTracker = {\n        consumerId: "customClickTracking",\n        delegateToOffers : (offers) => {\n            const handledTokens = new Set();\n\n            let addClickTracking = (metric) => {\n                window.SAP?.p13n && (window.SAP.p13n.clickTracker.tokens = window.SAP.p13n.clickTracker.tokens ? window.SAP.p13n.clickTracker.tokens : []);\n                window.SAP.p13n.clickTracker.tokens.push(metric);\n            };\n\n            if (Array.isArray(offers) && offers.length > 0) {\n                let newOffers = [];\n                let tokenRegExp = /let\\s+HANDLE_TOKEN\\s*=\\s*\'([^\']+)\'/;\n                offers.forEach(offer => {\n                    if (offer.action === "customCode") {\n                        const result = offer.content.match(tokenRegExp);\n                        if (result) {\n                            handledTokens.add(result[1]);\n                        }\n                    }\n                    if (offer.action !== "trackClick") {\n                        newOffers.push(offer);\n                    }\n                });\n\n                let changed = false;\n\n                offers.forEach(offer => {\n                    if (offer.action === "trackClick") {\n                        let exists = handledTokens.has(offer.clickTrackId);\n                        if (exists) {\n                            changed = true;\n                            addClickTracking(offer);\n                        } else {\n                            newOffers.push(offer);\n                        }\n                    }\n                });\n                return changed ? newOffers : offers;\n            }\n            return offers;\n        },\n        handle: (clickToken) => {\n            let tokens = window.SAP?.p13n?.clickTracker?.tokens;\n\t\t\tif (tokens || tokens > 0) {\n                let maxAttempts = 5;\n\t\t\t\tlet attempt = 0;\n\t\t\t\tlet interval = setInterval(() => {\n\t\t\t\t\tlet processed = false;\n                    tokens.forEach((token) => {\n                        if (token.done === undefined && token.clickTrackId === clickToken) {\n\t\t\t\t\t\t\tprocessed = true;\n                            let elements = document.querySelectorAll(token.selector);\n                            if (elements.length > 0) {\n                                token.done = true;\n                                elements.forEach((el) => {\n                                    el.addEventListener(\'click\', function(event) {\n                                        let notifications = [{\n                                            id: "id_" + Date.now(),\n                                            type: "click",\n                                            timestamp: Date.now(),\n                                            profileParameters: window.targetPageParamsObj.profile,\n                                            tokens: [token.clickTrackId]\n                                        }];\n                                        adobe.target.sendNotifications({\n                                            consumerId: window.SAP.p13n.clickTracker.consumerId,\n                                            request: {\n                                                notifications\n                                            }\n                                        });\n                                    });\n                                })\n                            }\n                        }\n                    });\n\t\t\t\t\tif (attempt > maxAttempts || !processed) {\n\t\t\t\t\t\tclearTimeout(interval);\n\t\t\t\t\t}\n\t\t\t\t\t++attempt;\n\t\t\t\t}, 1000);\n\t\t\t}\n        }\n    };\n  \n\t/**All below is related to SAPONEDX-22062 ticket\n\t * List with valid parameters.\n\t * It\'s being used as a filter.\n\t */\n\tvar targetParams = [\n\t\t"url_id",\n\t\t"campaigncode",\n\t\t"source"\n\t];\n\n\tvar tracking = {};\n\n\tvar addToTrackingObject = function(key, value){\n\t\ttracking["tracking.cmp_" + key] = value;\n\t};\n\n\t/**\n\t * Validates key and adds value to object.\n\t * @param {object} trackObj\n\t * @param {regex execution result} regResult\n\t */\n\tvar addParametersToTrackingObject = function (regResult) {\n\t\tif (regResult && regResult[1] && regResult[2]) {\n\t\t\tvar name = regResult[1];\n\t\t\tif (targetParams.indexOf(name) !== -1) {\n\t\t\t\taddToTrackingObject(name, regResult[2]);\n\t\t\t}\n\t\t}\n\t};\n\n\t/**\n\t * Adds referrer if it exists to object.\n\t */\n\tvar addReferrerToTrackingObject = function(){\n\t\tvar docReferrer = document.referrer;\n\t\tif(docReferrer.length > 0){\n\t\t\t/* fix for SAPONEDX-35337 */\n\t\t\tif (docReferrer.length > 256) {\n\t\t\t\tdocReferrer = docReferrer.split(\'?\')[0];\n\t\t\t}\n\t\t\taddToTrackingObject("referer", docReferrer);\n\t\t}\n\t};\n\n\t/**\n\t * Processing url parameters, filters them with targetParams list,\n\t * separatelly processing document referrer\n\t * and includes resulting object to target params object profile.\n\t */\n\tvar addTrackingCodes = function () {\n\t\tvar str = window.location.href.replace(/.*\\?/, "");\n\t\tvar paramRegex = /\\&/;\n\t\tvar paramList = str.split(paramRegex);\n\t\tfor (var i = 0; i < paramList.length; i++) {\n\t\t\tvar reg = /(.*)=(.*)/;\n\t\t\tvar regResult = reg.exec(paramList[i]);\n\t\t\taddParametersToTrackingObject(regResult);\n\t\t}\n\t\taddReferrerToTrackingObject();\n\t\tif(Object.keys(tracking).length >0){\n\t\t\tcreateTargetProfileObject();\n\t\t\twindow.targetPageParamsObj.profile = Object.assign(tracking, window.targetPageParamsObj.profile);\n\t\t}\n\t}; addTrackingCodes();\n\n\t/**\n\t * Processing session storage object to store it in target param obj profile.\n\t */\n\tvar getFormValues = function () {\n\t\tvar formvalues = JSON.parse(sessionStorage.getItem("formvalues"));\n\t\tif(formvalues){\n\t\t\tcreateTargetProfileObject();\n\t\t\twindow.targetPageParamsObj.profile = Object.assign(formvalues, window.targetPageParamsObj.profile);\n\t\t}\n\t}; getFormValues();\n\n  \t/**\n\t * Support for forcibly setting the height of the hero banner at the time of personalization rendering\n\t */\n    class PersonalizationObserver {\n\t\tstatic getInstance() {\n\t\t\tif (!window.__personalizationObserver__) {\n\t\t\t\twindow.__personalizationObserver__ = new PersonalizationObserver();\n\t\t\t}\n\t\n\t\t\treturn window.__personalizationObserver__;\n\t\t}\n\n\t\tsubscribe(callback) {\n\t\t\tthis.callback = callback;\n\t\n\t\t\tif (this.dispatched) {\n\t\t\t\tthis.callback(this.event);\n\t\t\t}\n\t\t}\n\n\t\tdispatch(event) {\n\t\t\tif (this.callback) {\n\t\t\t\tthis.callback(event);\n\t\t\t}\n\t\n\t\t\tthis.event = event;\n\t\t\tthis.dispatched = true;\n\t\t}\n\t}\n    PersonalizationObserver.getInstance();\n\twindow.fireGlobalMboxRequest();\n})();',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLddee13e4d83c47e78da6d3d6a13c99cf",name:"DL - AA - Video - Complete [SET+30]",events:[{modulePath:"gcoe-adobe-client-data-layer/src/lib/events/datalaye