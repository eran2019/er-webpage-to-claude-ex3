source:'var sccSiteName = "www.sap.com";\nvar sccChatState = {\n    sccParticipants: []\n};\n\nfunction sccLog() {\n  if (window.SAP && window.SAP.DTM && SAP.DTM.runMode != "prod")\n    console.log.apply(console, arguments);\n}\n\nvar createEvent = function createEvent(name, data) {\n  var event;\n\n  if (typeof CustomEvent === \'function\') {\n      event = new CustomEvent(name, {\n          bubbles: true,\n          detail: data\n      });\n  } else {\n      event = document.createEvent(\'CustomEvent\');\n      event.initCustomEvent(name, true, true, data);\n  }\n\n  return event;\n};\n\n\nfunction cloneObjectWithoutAttributes(obj, removedAttributes) {\n   var result = {};\n\n   var keys = Object.keys(obj);\n   for (var i = 0; i < keys.length; i++) {\n        if (!removedAttributes || removedAttributes.indexOf(keys[i]) < 0) {\n            result[keys[i]] = obj[keys[i]]\n        }\n   }\n\n  return result;\n}\n\nfunction recordChatbrainConfig(config_URL, status, data) {\n  return;\n\n  var SCC_CONFIG_RECORD = "sccConfigRecordEvent";\n  var response;\n  if (status == 200) {\n    response = cloneObjectWithoutAttributes(data, ["data_cc"]);\n  }\n\n  setTimeout(function() {\n    triggerSCCTrackingEvent( SCC_CONFIG_RECORD, "chatbrain", {config_URL: config_URL, response: response, status: status});\n  }, 1000);\n}\n\nfunction getQueryParameter(name) {\n  var results = new RegExp(\'[\\?&]\' + name + \'=([^&#]*)\').exec(window.location.href);\n  return results && results.length > 1 && decodeURI(results[1]) || "";\n}\n\nfunction getCountrySite() {\n  var country_sites = [\'africa\', \'australia\', \'austria\', \'belgie\', \'belgique\', \'brazil\', \'bulgaria\',\n                 \'canada\', \'canada-fr\', \'central-asia-caucasus\', \'corporate\', \'croatia\', \'cz\', \'denmark\',\n                 \'estonia\', \'finland\', \'france\', \'germany\', \'greece\', \'hk\', \'hungary\',\n                 \'india\', \'israel\', \'italy\', \'japan\', \'korea\', \'latinamerica\', \'latvia\', \'lithuania\',\n                 \'mena\', \'mena-ar\', \'netherlands\', \'norway\', \'poland\', \'portugal\', \'romania\',\n                 \'sea\', \'sk\', \'slovenia\', \'spain\', \'suisse\', \'sweden\', \'swiss\', \'turkey\',\n                 \'uk\', \'ukraine\', \'westbalkans\'];\n\n  var pathSegment = window.location.pathname.split(\'/\')[1]\n  if (country_sites.indexOf(pathSegment) >= 0) {\n      return "/" + pathSegment;\n  }\n\n  return "/global";\n}\n\nfunction getCampaigncode() {\n  var campaigncode = getQueryParameter(\'campaigncode\');\n  if (!campaigncode) {\n      campaigncode = _satellite.cookie.get(\'campaigncode\');\n  }\n\n  return campaigncode;\n}\n\nfunction triggerSCCTrackingEvent(eventName, eventProperty, detail) {\n  sccLog(\'[SCC Tracking]\', eventName, eventProperty, detail);\n  if (!eventName) return;\n\n  var eventInfo = {\n      "events": {}\n  };\n\n  eventInfo.events[eventName] = true;\n\n  if (eventProperty)\n      eventInfo[eventProperty] = detail || "";\n\n\tlet aaTrackedEvents = ["sccChatInviteDisplayed", "sccChatStarted", "sccChatTransferred", "sccChatEnded"];\n\tlet trackEventName = (aaTrackedEvents.indexOf(eventName) < 0) ? "trackData2" : "trackData";\n\n    SAP.sapdx.analytics.datalayer.triggerEvent(trackEventName, eventInfo);\n}\n\n\nvar SCC = {\n  SCC_CHAT_PARAM_NAME: "SCC_CHAT_PARAM",\n  loadChatParametersFromStorage: function (setParams) {\n    var result = {}\n    var parameters = localStorage.getItem(this.SCC_CHAT_PARAM_NAME);\n    if (parameters) {\n      try {\n        result = JSON.parse(parameters);\n        if (setParams) {\n          if (result.sccContactID) {\n            sccChatState.sccContactID = result.sccContactID;\n          }\n          if (result.sccInteractionID) {\n            sccChatState.sccInteractionID = result.sccInteractionID;\n          }\n          if (result.isBot) {\n            sccChatState.isBot = result.isBot;\n          }\n          if (result.sccInviteAccepted) {\n            sccChatState.sccInviteAccepted = result.sccInviteAccepted;\n          }\n          if (result.sccParticipants) {\n            sccChatState.sccParticipants = result.sccParticipants;\n          }\n          if (result.sccTransferCount) {\n            sccChatState.sccTransferCount = result.sccTransferCount;\n          }\n          if (result.chatType) {\n            sccChatState.chatType = result.chatType;\n          }\n        }\n      } catch (ex) {\n        sccLog("error when parsing session storage chat parameters: ", ex);\n      }\n    }\n\n    return result;\n  },\n  removeChatParametersFromStorage: function () {\n    localStorage.removeItem(this.SCC_CHAT_PARAM_NAME);\n  },\n  saveChatParametersInStorage: function (params) {\n    var parameters = localStorage.getItem(this.SCC_CHAT_PARAM_NAME);\n    if (parameters) {\n      try {\n        parameters = JSON.parse(parameters);\n      } catch(ex) {\n        parameters = {}\n      }\n    } else {\n      parameters = {}\n    }\n\n    if (params.startTime) {\n      parameters.startTime = params.startTime;\n    }\n    if (params.isBot !== undefined) {\n      parameters.isBot = params.isBot;\n    }\n    if (params.sccInviteAccepted) {\n      parameters.sccInviteAccepted = params.sccInviteAccepted;\n    }\n    if (params.chatType) {\n      parameters.chatType = params.chatType;\n    }\n    if (params.endTime) {\n      parameters.endTime = params.endTime;\n    }\n    if (params.sccContactID) {\n      parameters.sccContactID = params.sccContactID;\n    }\n    if (params.sccInteractionID) {\n      parameters.sccInteractionID = params.sccInteractionID;\n    }\n    if (params.sccParticipants) {\n      parameters.sccParticipants = params.sccParticipants;\n    }\n    if (params.sccTransferCount) {\n      parameters.sccTransferCount = params.sccTransferCount;\n    }\n    if (params.agent_chat_start_url) {\n      parameters.agent_chat_start_url = params.agent_chat_start_url;\n    }\n    if (params.ai_summary) {\n      parameters.ai_summary = params.ai_summary;\n    }\n    if (params.chat_open_url) {\n      parameters.chat_open_url = params.chat_open_url;\n    }\n\n    localStorage.setItem(this.SCC_CHAT_PARAM_NAME, JSON.stringify(parameters));\n  },\n  SCC_CONFIG_INFO_NAME: "SCC_CONFIG_INFO",\n  saveConfigInfo: function (data) {\n    data.currentURL = window.location.href;\n    localStorage.setItem(this.SCC_CONFIG_INFO_NAME, JSON.stringify(data))\n  },\n  loadConfigInfo: function () {\n    this.loadChatParametersFromStorage(true);\n    var data = localStorage.getItem(this.SCC_CONFIG_INFO_NAME);\n    if (data)\n      data = JSON.parse(data);\n\n    return data;\n  },\n  removeConfigInfo: function() {\n    localStorage.removeItem(this.SCC_CONFIG_INFO_NAME);\n  },\n  removeHandraiserInfo: function () {\n    localStorage.removeItem(\'chatAgentConfig\');\n    localStorage.removeItem(\'extraCadData\');\n  }\n};\n\n\nfunction isAgentType(user) {\n  if (!user) return false;\n  return user.endsWith("@SAP") || user.indexOf("Herr") >= 0 || user.indexOf("Frau") >= 0;\n}\n\nfunction getAgent(participant_list) {\n  var names = [];\n  // This doesn\'t work for DE as they use chat names without the @SAP but that\'s ok as we do not want to identify them\n  participant_list.forEach ( function ( item ) {\n\n      if (isAgentType(item)) {\n          names.push(item);\n      }\n  });\n\n  return names.length > 0 ? names.join("|") : "unknown";\n}\n\nvar surveyWrapper = {\n  openSurvey: function (server_config) {\n    var storedParams = SCC.loadChatParametersFromStorage();\n\n    var conversationDuration;\n    if (storedParams.startTime && storedParams.endTime) {\n      conversationDuration = Math.ceil((new Date(storedParams.endTime) - new Date(storedParams.startTime))/1000);\n    }\n\n    var conversationid = sccChatState.sccInteractionID || "unknown";\n    var queuename = server_config.queuename;\n    var queueaddress = server_config.queueaddress;\n\n    var url = server_config.currentURL || window.location.href;\n    var surveyId = SAP.DTM.runMode != "prod" ? "SV_bQrT3mpRCQijox0" : "SV_8H8hSHkQRUA38Lb";\n    var participants = (sccChatState.sccParticipants || []).join("|");\n    var agentName = getAgent(sccChatState.sccParticipants);\n    var contact_id = (sccChatState.sccContactID || "unknown");\n    //var surveyId = "SV_6Lob9EMSP89xXYV"; // Backup, not currently used\n    var src = "https://sapinsights.eu.qualtrics.com/jfe/form/" + surveyId +\n      "?Site=" + encodeURIComponent(window.location.host) +\n      "&original_contact_id=" + conversationid +\n      "&contact_id=" + contact_id +\n      "&chat_url=" + encodeURIComponent("https://cc-c1sccp1035467.cc.sinch.com/ecf/latest/communicationpanel/index.jsp#interactionid=" + conversationid) +\n      "&QueueName=" + encodeURIComponent(queuename) +\n      "&QueueAddress=" + encodeURIComponent(queueaddress) +\n      "&CurrentPageURL=" + encodeURIComponent(url) +\n      "&ParticipantNames=" + encodeURIComponent(participants) +\n      "&AgentChat=" + (isAgentType(participants) ? "true" : "false") +\n      "&AgentName=" + agentName +\n      "&VisitorCountry=" + _satellite.cookie.get(\'country\') || "unknown";\n\n    if (server_config.language) {\n      src += "&Q_Language=" + server_config.language;\n    }\n    \n    if(window.lastSurveyID) {\n        src += "&SurveyID=" + window.lastSurveyID;\n    }\n\n    if (conversationDuration) {\n      src += "&chatStartTime=" + storedParams.startTime;\n      src += "&chatEndTime=" + storedParams.endTime;\n      src += "&chatDuration=" + conversationDuration;\n    }\n\n    openCallMeNowSurveyDialog(src);\n\n    var surveyInfo = {surveyId: surveyId, conversationid: conversationid, contactid: contact_id, queuename: queuename, queueaddress: queueaddress, duration: conversationDuration};\n    triggerSCCTrackingEvent("sccSurveyOpened", "surveyInfo", surveyInfo);\n\n  }\n}\n\nvar DISPLAY_OVERLAY_SESSION_KEY = "sccOverlayDisplayed";\n\nvar sccChatEvents = {\n  "connected": "sccChatStarted",\n  "proceeding": "sccChatTransferred",\n  "completed": "sccChatEnded"\n};\n\nwindow.lastSurveyID = "";\n\n// Helper function to safely escape string values for use in selectors\nfunction escapeString(value) {\n  if (!value || typeof value !== \'string\') return \'\';\n  return (typeof CSS !== \'undefined\' && CSS.escape) ? CSS.escape(value) : value.replace(/(["\\\\])/g, \'\\\\$1\');\n}\n\nfunction getMetaContentByName(name) {\n  const escapedName = escapeString(name);\n  if (!escapedName) return null;\n  const meta = document.querySelector(`meta[name="${escapedName}"]`);\n  return meta ? meta.getAttribute(\'content\') : null;\n}\n\nfunction getClientData(chat) {\n  var data = {\n    "client_id": _satellite.cookie.get(\'client\'),\n    "adobe_id": _satellite.getVisitorId().getMarketingCloudVisitorID(),\n    "url": window.location.href,\n    "countrySite": getCountrySite()\n  };\n  \n  if (window.crypto) {\n    window.lastSurveyID = window.crypto.randomUUID();\n    data.SurveyID = window.lastSurveyID;\n  }\n  \n  if (document.referrer) {\n   data.referrer = document.referrer\n  }\n    \n    const storedParams = SCC.loadChatParametersFromStorage();\n    data.agent_chat_start_url = window.agent_chat_start_url\n      || (storedParams && storedParams.agent_chat_start_url)\n      || window.location.href;\n    if (storedParams && Object.prototype.hasOwnProperty.call(storedParams, \'chat_open_url\') && storedParams.chat_open_url) {\n      data.url = storedParams.chat_open_url;\n    }\n    var aiSummaryCandidate;\n    if (typeof window.ai_summary !== \'undefined\') {\n      aiSummaryCandidate = window.ai_summary;\n    } else if (storedParams && Object.prototype.hasOwnProperty.call(storedParams, \'ai_summary\')) {\n      aiSummaryCandidate = storedParams.ai_summary;\n    } else {\n      aiSummaryCandidate = \'\';\n    }\n    data.ai_summary = aiSummaryCandidate;\n    \n  if (!data.adobe_id) {\n    var alt_adobe_id_key  = "alt_adobe_id";\n    var alt_adobe_id = localStorage.getItem(alt_adobe_id_key);\n    if(!alt_adobe_id) {\n        alt_adobe_id = new Date().getTime() + "" + Math.random();\n        localStorage.setItem(alt_adobe_id_key, alt_adobe_id);\n    }\n\n    data.adobe_id = alt_adobe_id\n  }\n  \n  var sixsense = _satellite.getVar(\'localStorage - _6senseCompanyDetails\');\n  if (_satellite.getVar(\'isConsentEnabled\')("6sense.com", 1) && sixsense && sixsense.company) {\n      data["organization"] = sixsense.company.name;\n      data["country"] = sixsense.company.country;\n      data["city"] = sixsense.company.city;\n      data["employee_count"] = sixsense.company.employee_count;\n      data["annual_revenue"] = sixsense.company.annual_revenue;\n  }\n\n  data["useragent"] = navigator.userAgent;\n  \n  if (window.bowser) {\n    const browserInfo = window.bowser.getParser(window.navigator.userAgent).parsedResult;\n    data["device"] = browserInfo.platform.type;\n    data["browser"] = browserInfo.browser.name + " " + browserInfo.browser.version;\n    data["os"] = browserInfo.os.name;\n  }\n  function findElementByAttribute(attribute, value) {\n    // Validate inputs\n    if (!attribute || typeof attribute !== \'string\' || !value || typeof value !== \'string\') {\n      return null;\n    }\n    // Only escape the value, not the attribute name\n    const escapedValue = escapeString(value);\n    if (!escapedValue) return null;\n    const selector = `[${attribute}="${escapedValue}"]`;\n    return document.querySelector(selector);\n  }\n\n  function elementHasClass(element, className) {\n    if (!element || !element.classList) return false;\n    // Validate className is a non-empty string\n    if (!className || typeof className !== \'string\' || className.trim() === \'\') return false;\n    return element.classList.contains(className);\n  }\n\n  function findChildWithClass(parentElement, className) {\n    if (!parentElement || typeof parentElement.querySelector !== \'function\') {\n      return null;\n    }\n    const escapedClass = escapeString(className);\n    if (!escapedClass) return null;\n    // Use [class*="..."] for partial class name matching\n    return parentElement.querySelector(`[class*="${escapedClass}"]`);\n  }\n\n  function isDisplayedAsBlock(element) {\n    if (!element || typeof window.getComputedStyle !== \'function\') {\n      return false;\n    }\n    const computedStyle = window.getComputedStyle(element);\n    return computedStyle.display === \'block\';\n  }\n  const campaigncode = getCampaigncode();\n  if (campaigncode) data["campaigncode"] = campaigncode;\n  let product_category = getMetaContentByName(\'product_category\');\n  let product_sub_category = getMetaContentByName(`product_category_${product_category?.toLowerCase().split(\' \').join(\'_\')}`);\n  let software_product =  getMetaContentByName(\'software_product\');\n  let software_sub_product =  getMetaContentByName(`software_product_${software_product?.toLowerCase().split(\' \').join(\'_\')}`);\n  let industry_category =  getMetaContentByName(\'industry\');\n  let industry_sub_category =  getMetaContentByName(`industry_${industry_category?.toLowerCase().split(\' \').join(\'_\')}`);\n  let mobileResourceTabOpened = elementHasClass(findElementByAttribute(\'aria-label\',"Resources"), \'active\')\n  let desktopResourceTabOpened = isDisplayedAsBlock(findChildWithClass(findElementByAttribute(\'data-title\',"Resources"), \'dropdown-nested-nav-tabs-active\'))\n\n  data[\'product_category\'] = product_category\n  data[\'product_sub_category\'] = product_sub_category\n  data[\'industry_category\'] = industry_category\n  data[\'industry_sub_category\'] = industry_sub_category\n  data[\'software_product\'] = software_product\n  data[\'software_sub_product\'] = software_sub_product\n  data[\'resource_tab_active\'] = mobileResourceTabOpened || desktopResourceTabOpened\n  sccLog("[SCC Chat Client]sending cad data: ", data);\n\n  return data;\n}\n\nvar cvcWrapper = {\n  sccCadDataSet:false,\n  configInfo: {},\n  currentQueue: null,\n  setCadData: function (fromOverlay, extraCadData) {\n      if (this.configInfo.server_config.chatActive) {\n      return;\n      }\n      //if (this.sccCadDataSet || this.configInfo.server_config.chatActive) return; //TODO: Review if we need set cad data on the second page\n\n      var data = getClientData(true);\n\n      //data["queueStatuses"] = JSON.stringify(this.configInfo.server_config.queues_to_watch);\n\n      if (this.configInfo.server_config.agent_campaigncode) {\n        data["campaigncode"] = this.configInfo.server_config.agent_campaigncode;\n      } else if (this.configInfo.loader_config.campaigncode) {\n          data["campaigncode"] = this.configInfo.loader_config.campaigncode;\n      } else if (this.configInfo.server_config.crm_code) {\n          data["campaigncode"] = this.configInfo.server_config.crm_code;\n      }\n\n      data["useragent"] = navigator.userAgent;\n\n      if (fromOverlay === "overlay") {\n          data["from_overlay"] = true;\n      }\n\n      if (this.configInfo.server_config.first_message) {\n          data["first_message"] = this.configInfo.server_config.first_message;\n      }\n\n      if (this.configInfo.server_config.popup_source) {\n        data["chat_source"] = this.configInfo.server_config.popup_source;\n      }\n    \n      if (extraCadData && Object.entries(extraCadData).length !== 0) {\n        Object.assign(data, extraCadData);\n      }\n\n      sccLog("[SCC Chat Client]sending cad data: ", data);\n\n      try {\n        window.cvc.setCad(data);\n        this.sccCadDataSet = true;\n\n        triggerSCCTrackingEvent("sccSetCadData", "cadData", data);\n        window.sccCadDataSet = true;\n      } catch(ex) {\n        triggerSCCTrackingEvent("sccSetCadDataFailed", "setCadDataError", {error: ex.message});\n      }\n  },\n\n  sccClientOpened: false,\n  openSCCClient: function (fromOverlay, server_config, loader_config, extraCadData) {\n      if (this.sccClientOpened) return;\n\n      sccLog("current queue: ", this.currentQueue);\n      sccLog("incoming queue: ", server_config.queueaddress, this.currentQueue && this.currentQueue != server_config.queueaddress);\n      this.configInfo = {server_config: server_config, loader_config: loader_config};\n\n      if (window.cvc) {\n\n          if (this.currentQueue && this.currentQueue != server_config.queueaddress) {\n              sccLog("switching to queue:", server_config.queueaddress);\n              cvc.setOption({qu:[{"name":server_config.queuename,"address":server_config.queueaddress}]});\n              this.currentQueue = server_config.queueaddress;\n              this.setCadData(fromOverlay, extraCadData);\n\n              setTimeout(function() { cvcWrapper.openSCCClient(fromOverlay, server_config, loader_config, extraCadData);}, 2000);\n              return;\n          }\n\n          sccLog("[SCC Chat Client]chat starting...", server_config.queueaddress);\n\n          window.chatNowClickedTime = performance.now();\n          try {\n            var stored = SCC.loadChatParametersFromStorage();\n            if (!stored || !stored.chat_open_url) {\n              SCC.saveChatParametersInStorage({ chat_open_url: window.location.href });\n            }\n          } catch (e) {\n            sccLog("[SCC Chat Client] Error saving chat_open_url:", e);\n          }\n          this.setCadData(fromOverlay, extraCadData);\n\n          var g_code_page = server_config.language || "en";\n          if (g_code_page === \'tw\' ||\n              g_code_page === \'el\') {\n            window.cvc.setLanguage(g_code_page, `https://www.sap.com/dam/site/idea-place/chat/i18n.${g_code_page}.properties`);\n          } else if (g_code_page === \'kr\' || g_code_page === \'ko\') {\n            window.cvc.setLanguage(\'kr\', `https://www.sap.com/dam/site/idea-place/chat/i18n.kr.properties`);\n          } else {\n            window.cvc.setLanguage(g_code_page);\n          }\n\n          $(\'.contactModule\').hide();\n        \n          triggerSCCTrackingEvent("sccCallingStartChat", "callInfo", {queue: server_config.queueaddress, sccCadDataSet: window.sccCadDataSet});\n          \n          if (!window.agent_chat_start_url) {\n            window.agent_chat_start_url = window.location.href;\n            SCC.saveChatParametersInStorage({ agent_chat_start_url: window.agent_chat_start_url });\n          }\n\n          setTimeout(function() {\n            window.cvc.setVisible(true);\n            window.cvc.startChat();\n          }, 200);\n\n          this.sccClientOpened = true;\n          this.currentQueue = server_config.queueaddress;\n\n          SCC.saveConfigInfo(server_config)\n\n          sessionStorage.setItem(DISPLAY_OVERLAY_SESSION_KEY, true); //TODO: Review: once the user chatted, no need to display the overlay?\n\n\n      }\n  },\n\n  sccClientLoaded: false,\n  loadCVC: function (showCVC, server_config,loader_config) {\n      if (cvcWrapper.sccClientLoaded){\n        document.dispatchEvent(createEvent(\'CVCClientLoaded\'));\n        return;\n      }\n    \n      this.configInfo = {server_config: server_config, loader_config: loader_config};\n      //sccLog("loading cvc:", !!window.cvc);\n      if (window.cvc) {\n          //cvc.setOption({qu:[{"name":server_config.queuename,"address":server_config.queueaddress}]});\n          //window.cvc.attachEvent("chatState", cvcWrapper.cvcChatStateEventHandlerfunction);    \n      } else {\n        var scr = document.createElement("script");\n        scr.src = server_config.chatURL;\n        scr.id = "cvc-c";\n        scr.setAttribute("data-cc", server_config.data_cc);\n        scr.setAttribute("data-ic", "e30=");\n        document.head.appendChild(scr);\n\n        scr.onload = function () {\n            if (window.cvc) {\n              sccLog("[SCC Chat Client]client loaded");\n                //if(!showCVC)\n\t\t//\t      window.cvc.setVisible(false);\n                window.cvc.attachEvent("chatState", cvcWrapper.cvcChatStateEventHandlerfunction);\n                document.dispatchEvent(createEvent(\'CVCClientLoaded\'));\n            }\n        };\n      }\n\n      cvcWrapper.sccClientLoaded = true;\n      cvcWrapper.currentQueue = server_config.queueaddress;\n  },\n  detachChatStateEventHandler: function () {\n    if (window.cvc) window.cvc.detachEvent("chatState", cvcWrapper.cvcChatStateEventHandlerfunction);\n  },\n\n    fetchDetails: function() {\n        return new Promise(\n            (resolve, reject) => {\n                setTimeout(\n                    () => {\n                        window.cvc.getDetails((details) => { resolve(details); })\n                    },\n                    200);\n            }\n        );\n    },\n\n  cvcChatStateEventHandlerfunction: function (e) {\n    sccLog("[SCC Chat Client]chatState: ", e);\n    if (e.detail) {\n        sccChatState.sccParticipants = sccChatState.sccParticipants || [];\n\t\tsccChatState.sccTransferCount = sccChatState.sccTransferCount || 0;\n\n        if (!sccChatState.chatType) {\n            sccChatState.chatType = window.sccLoaderConfig && window.sccLoaderConfig.chatoffsite\n                  ? "User Initiated:Off Site"\n                  : (sccChatState.sccInviteAccepted ? "Invited" : "User Initiated:Site");\n            SCC.saveChatParametersInStorage({ "chatType": sccChatState.chatType });\n        }\n        var chatInfo = {\n            chatType: sccChatState.chatType\n        };\n\n        if ((e.detail == "connected") || (e.detail == "completed")) {\n            chatInfo.queueaddress = cvcWrapper.configInfo.server_config.queueaddress || "";  //TODO: REVIEW\n        }\n        if (e.detail == "completed") {\n            chatInfo.isBot = sccChatState.isBot;\n        }\n\n        if (e.detail == "connected") {\n            chatInfo.connectingTime = performance.now() - (window.chatNowClickedTime || 0);\n            SCC.saveChatParametersInStorage({startTime: new Date()});\n\t\t    chatInfo.isTransfer = (sccChatState.sccTransferCount > 0);\n        } else if (e.detail == "proceeding") {\n            sccChatState.sccTransferCount++;\n            SCC.saveChatParametersInStorage({"sccTransferCount": sccChatState.sccTransferCount});\n\t\t}\n\n        cvcWrapper.fetchDetails().then(details => {\n              sccLog(details.error || details);\n\n              // The client may send an message at the end of chat that blanks out the id but we want to keep it to forward to Qualtrics\n              // So make sure we do not update the id if the id is too small. IDs will be 32 chars so > 10 should be enough.\n              if ( details.id && details.id.length > 10 ) {\n                chatInfo.sccInteractionID = details.id;\n                sccChatState.sccInteractionID = details.id; // contact_id as of 2011 SP3. It also stays around after the chat completes.\n                SCC.saveChatParametersInStorage({sccInteractionID: sccChatState.sccInteractionID});\n              } else {\n                chatInfo.sccInteractionID = sccChatState.sccInteractionID;\n              }\n\n              // Keep track of all participants whether they leave the conversation\n              if (details.participants) {\n                  chatInfo.participants = details.participants;\n\n                  details.participants.forEach( function(p) {\n                      if (sccChatState.sccParticipants.indexOf(p) == -1){\n                          sccChatState.sccParticipants.push(p);\n                      }\n                      if (e.detail == "connected") {\n                        if (p.toLowerCase() === "visitor") return;\n\n                        if (isAgentType(p)) { \n                          chatInfo.isBot = false; //once agent is in the list, isBot is always immutable\n                        } else if (typeof chatInfo.isBot === "undefined") {\n                          chatInfo.isBot = true;\n                        }\n                      }\n                  });\n                  sccChatState.isBot = chatInfo.isBot;\n\n                  SCC.saveChatParametersInStorage({sccParticipants: sccChatState.sccParticipants, isBot: sccChatState.isBot });\n              }\n\n              if (cvcWrapper.configInfo.server_config.popup_source) {\n                  chatInfo.chat_source = cvcWrapper.configInfo.server_config.popup_source;\n              }\n\n              triggerSCCTrackingEvent(sccChatEvents[e.detail], "chatInfo", chatInfo);\n        }).then(() => {\n          if (e.detail == "completed") {\n            sccLog("[SCC Completed]....");\n            if(document.visibilityState !== "visible")\n               window.cvc.setVisible(false);\n\n            cvcWrapper.sccClientOpened = false;  //TODO: REVIEW\n\n            SCC.saveChatParametersInStorage({endTime: new Date()});\n\n            if (!cvcWrapper.configInfo.server_config.noSurvey && document.visibilityState === "visible") {\n              surveyWrapper.openSurvey(cvcWrapper.configInfo.server_config);\n            }\n\n            setTimeout(cvcWrapper.cleanedUpAndRestore, 2000);\n          }\n        });\n    }\n  },\n  cleanedUpAndRestore: function () {\n    //TODO: Review\n    sccChatState = {\n        sccParticipants: []\n    };\n    window.sccLoaderConfig.chatoffsite = undefined;\n\n    SCC.removeChatParametersFromStorage();\n    SCC.removeConfigInfo();\n    SCC.removeHandraiserInfo();\n\n    if(cvcWrapper.configInfo.server_config.chatActive) {\n      document.dispatchEvent(createEvent(\'SCCChatClosed\', cvcWrapper.configInfo.server_config));\n      //monitorSCCQueue(); //TODO REVIEW, need trigger an event\n    }\n  }\n}\n\nvar IDLE_TIMEOUT_IN_MILS = 60 * 1000\nvar TIMER_TIMEOUT_IN_MILS = 10 * 1000;\n\nvar sccTimer = {\n  timerID: "",\n  callbacks: {},\n  resetLastSetTime: function (timeInMillis) {\n    sccTimer.callbacks[timeInMillis] = sccTimer.callbacks[timeInMillis] || [];\n    sccTimer.callbacks[timeInMillis].lastSetTime = new Date();\n  },\n  timeEventHandler: function () {\n    var newTime = new Date();\n    //sccLog("timeout", newTime);\n\n    for (millis in sccTimer.callbacks) {\n      var lastSetTime = sccTimer.callbacks[millis].lastSetTime || new Date();\n      //sccLog("time diff: ", newTime - lastSetTime);\n      if (newTime - lastSetTime >= millis) {\n\n        sccTimer.callbacks[millis].forEach(function(callback) { callback(); });\n        sccTimer.callbacks[millis].lastSetTime = newTime;\n      }\n    }\n  },\n  addCallback: function(timeInMillis, callback) {\n    this.callbacks[timeInMillis] = this.callbacks[timeInMillis] || [];\n    this.callbacks[timeInMillis].push(callback);\n    if (!this.callbacks[timeInMillis].lastSetTime) {\n      this.callbacks[timeInMillis].lastSetTime = new Date();\n    }\n  },\n  removeCallback: function(timeInMillis, callback) {\n    this.callbacks[timeInMillis] = this.callbacks[timeInMillis] || [];\n    if (this.callbacks[timeInMillis].length == 0) return;\n\n    var lastSetTime = this.callbacks[timeInMillis].lastSetTime;\n\n    this.callbacks[timeInMillis] = this.callbacks[timeInMillis].filter(function(cb) { return cb != callback });\n    this.callbacks[timeInMillis].lastSetTime = lastSetTime || new Date();\n  },\n  startTimer: function() {\n    this.stopTimer();\n    this.timerID = setInterval(this.timeEventHandler, TIMER_TIMEOUT_IN_MILS);\n  },\n  stopTimer: function() {\n    if (this.timerID) {\n      clearInterval(this.timerID);\n    }\n  }\n};\n\nvar queueWatcher = {\n  timerTimeoutInMils: 10000,\n  chatBrainURL:"",\n  agentAvailabilityURL: "",\n  started: false,\n  queues_to_watch: {},\n  addQueues: function(queues, callback) {\n    sccLog("adding queues: ", queues);\n    for(queue in queues) {\n      this.queues_to_watch[queue] = this.queues_to_watch[queue] || [];\n      this.queues_to_watch[queue].push(callback);\n    }\n  },\n  removeQueues: function(queues, callback) {\n    for(queue in queues) {\n      this.queues_to_watch[queue] = this.queues_to_watch[queue] || [];\n      this.queues_to_watch[queue] = this.queues_to_watch[queue].filter(function(cb) { return cb != callback; });\n    }\n  },\n  checkQueues: function() {\n    sccLog("checkQueues:", queueWatcher.availabilityServiceUrl);\n    if (!queueWatcher.availabilityServiceUrl) return;\n    if (Object.keys(queueWatcher.queues_to_watch).length === 0) return;\n\n    var queueNames = Object.keys(queueWatcher.queues_to_watch).map(function (q) { return q.replace(/ /g, \'+\'); });\n    var queues = queueNames.join(\'&queue=\');\n\n    $.getJSON(queueWatcher.availabilityServiceUrl + \'?queue=\' + queues + "&r=" + Math.random(), function(statuses) {\n            queueWatcher.processQueues(statuses);\n        }, function() {\n            queueWatcher.processQueues({});\n        });\n  },\n  processQueues: function(statuses) {\n    for (queue in queueWatcher.queues_to_watch) {\n      queueWatcher.queues_to_watch[queue].forEach(function(callback) { callback(statuses); });\n    }\n  },\n  startWatcher: function() {\n    if (!this.started) {\n      sccTimer.addCallback(this.timerTimeoutInMils, queueWatcher.checkQueues);\n      this.started = true;\n    }\n    queueWatcher.checkQueues();\n  },\n  stopWatcher: function() {\n    if (this.started) {\n      sccTimer.removeCallback(this.timerTimeoutInMils, queueWatcher.checkQueues);\n      this.started = true;\n    }\n  }\n};\n\nvar sccEventListener = {\n  configInfo: {},\n  receiveMessage: function (e) {\n      if (/sinch.com/.test(e.origin) && e.data) {\n//\t\t\tsccLog("[SCC Client Events - Data]:", e.data);\n        let data = e.data;\n        if (typeof data === "string" && data.includes(\'{\')) {\n            try {\n                data = JSON.parse(data);\n            } catch(ex) {\n                sccLog("[SCC Client Events - Data]: failed to parse:", e.data);\n                return;\n            }\n        }\n\n        if (data.type === "active") {\n            if (data.content === true) {\n                if (!cvcWrapper.sccClientOpened) {\n                    if (sccChatState.sccParticipants.length == 0)\n                        SCC.loadChatParametersFromStorage(true);\n                    \n                    cvcWrapper.sccClientOpened = true;\n                }\n            } else {\n                cvcWrapper.sccClientOpened = false;\n            }\n        } else if (data.type == "state" && data.content == "false") {\n          //window.cvc.setVisible(false);\n          cvcWrapper.sccClientOpened = false;\n        } else if (data.source == "connector") {\n            sccChatState.sccContactID = data.contact_id;\n            SCC.saveChatParametersInStorage({sccContactID: sccChatState.sccContactID});\n        }\n    } else {\n        if (!e.data || !e.data.length || e.data[0] != \'scc-overlay\') return;\n        sccLog("[SCC Overlay Events]:", e);\n        const chatInvitePopupResult = e.data[1];\n\n        if (chatInvitePopupResult == \'chat\') {\n            window.agent_chat_start_url = window.location.href;\n            sccChatState.sccInviteAccepted = true;\n            \n            var storedParams = SCC.loadChatParametersFromStorage();\n            SCC.saveChatParametersInStorage({\n                sccInviteAccepted: sccChatState.sccInviteAccepted,\n                agent_chat_start_url: window.agent_chat_start_url,\n                ai_summary: window.ai_summary,\n                chat_open_url: (storedParams?.chat_open_url) || window.location.href\n            });\n\n            if (_satellite.getVar(\'isProductAdvisorEnabled\')) {\n                document.dispatchEvent(new CustomEvent("AdvisorChatOpenOnContactModule", {\n                    detail: { requireHumanHandoff: true }\n                }));\n                document.dispatchEvent(new CustomEvent("AdvisorChatHumanHandoff", {\n                    detail: { requireHumanHandoff: true }\n                }));\n            } else {\n                cvcWrapper.openSCCClient("overlay", sccEventListener.configInfo.server_config, sccEventListener.configInfo.loader_config);\n            }\n\n\t\t\tsccChatState.sccInviteAccepted = true;\n\t\t\tSCC.saveChatParametersInStorage({sccInviteAccepted: sccChatState.sccInviteAccepted});\n            triggerSCCTrackingEvent("sccChatInviteAccepted", "overlay", {rule: sccChatState.sccOverlayRule, queueaddress: sccEventListener.configInfo.server_config.queueaddress, chat_source: sccEventListener.configInfo.server_config.popup_source});\n        }  else if (chatInvitePopupResult == \'reject\') {\n            triggerSCCTrackingEvent("sccChatInviteRejected", "overlay", {rule: sccChatState.sccOverlayRule, queueaddress: sccEventListener.configInfo.server_config.queueaddress, chat_source: sccEventListener.configInfo.server_config.popup_source});\n        }  else if (chatInvitePopupResult == \'error\') {\n            triggerSCCTrackingEvent("sccChatPopupError", "overlay", {rule: sccChatState.sccOverlayRule, queueaddress: sccEventListener.configInfo.server_config.queueaddress, chat_source: sccEventListener.configInfo.server_config.popup_source, error: e.data[2]});\n        }\n\n        $.magnificPopup.close();\n    }\n  },\n  startListener: function() {\n    window.addEventListener("message", sccEventListener.receiveMessage, false);\n  },\n  stopListener: function() {\n    window.removeEventListener("message", sccEventListener.receiveMessage);\n  }\n}\n\nfunction startSCCLocalChat(config, loader_config) {\n  sccLog("starting local chat:", config);\n  var pending_chat_invite = false;\n\n  var server_config = config.server_config;\n  server_config.queues_to_watch = server_config.queues_to_watch || {};\n\n  var chatBrainURL = server_config.chatBrainURL ? server_config.chatBrainURL : loader_config.chatBrainURL;\n  var availabilityServiceUrl = server_config.agentAvailabilityURL ? server_config.agentAvailabilityURL : loader_config.agentAvailabilityURL;\n  if (!availabilityServiceUrl) { // backward compatibility\n    availabilityServiceUrl = chatBrainURL;\n  }\n  queueWatcher.availabilityServiceUrl = availabilityServiceUrl;\n  queueWatcher.chatBrainURL = chatBrainURL;\n  queueWatcher.timerTimeoutInMils = loader_config.timerTimeoutInMils;\n\n  var sccQeueuStatuses = {};\n\n  function openSCCClient() {\n    const isExtraCadData = getQueryParameter("extracaddata");\n \n    sccLog("[SCC Debug]opening local chat");\n    delete server_config.popup_source;\n \n    if (isExtraCadData) {\n      const extraCadData = JSON.parse(localStorage.getItem("extraCadData"));\n      cvcWrapper.openSCCClient("", server_config, loader_config, extraCadData);\n    } else {\n      cvcWrapper.openSCCClient("", server_config, loader_config);\n    }\n  }\n\n  function loadCAIBot(showCVC) {\n    sccLog("[SCC Debug]loading local chat");\n    cvcWrapper.loadCVC(showCVC, server_config, loader_config);\n  }\n\n  //update handlers on online/offline links\n  function enableChatNowForSCCClient(online) {\n      if (online) {\n          if (!$(\'.dtm-live-chat\').hasClass(\'online\')) {\n            document.dispatchEvent(createEvent(\'ContactUsOnlineChat\'));\n            window.ContactUsOnlineChat = true;\n\n              loadCAIBot();\n          }\n      } else {\n          if ($(\'.dtm-live-chat\').hasClass(\'online\')) {\n            document.dispatchEvent(createEvent(\'ContactUsOfflineChat\'));\n            window.ContactUsOnlineChat = false;\n\n            $(\'#sccChat\').hide();\n          }\n      }\n  }\n\n  function canDisplayChatOverlay() {\n      //return false;\n      if (cvcWrapper.sccClientOpened) return false;\n    \n      if (window.location.pathname.indexOf(\'/discover/\') >= 0) return false;\n\n      if (window.location.pathname.indexOf(\'/events/sapphire.html\') >= 0) return false;\n    \n      const contact_us = document.querySelector("div[data-component=\'ContactUs\']");\n      if (!contact_us || contact_us.childElementCount === 0) return false;\n\n      if (window.location.pathname.indexOf(\'/integrated-reports/\') >= 0 || window.location.pathname.indexOf(\'/investors/\') >= 0 || window.location.pathname.indexOf(\'/products/sme-business-software/hr.html\') == 0) return false;\n      //if($(\'.mfp-container\').length || $(\'.formEngineContainer\').length) return false;\n\n      var isFromSAP = _satellite.getVar("isFromSAP");\n      if (isFromSAP && isFromSAP()) return false;\n\n      if (loader_config.isMobile) return false;\n\n      if (top !== window) return false; //do not display the overlay in a child window\n      if (window.videoState == "playing" || window.videoState == "paused") {\n        pending_chat_invite = !!server_config.popup_source;\n        return false; //don\'t display the overlay when video is being played\n      }\n\n      if (SAP.wcms.sapdx.page.lightBox.pageRating && (SAP.wcms.sapdx.page.lightBox.pageRating.isVideoLightbox && !SAP.wcms.sapdx.page.lightBox.pageRating.isVideoLightbox()) && $.magnificPopup.instance.isOpen) {\n        pending_chat_invite = !!server_config.popup_source;\n        return false;\n      }\n\n      if ($(\'video\').length > 0 && $(\'video\').toArray().some(function(v) { return !v.paused && !v.ended; })) {\n        pending_chat_invite = !!server_config.popup_source;\n        return false;\n      }\n\n      if (sessionStorage.getItem(DISPLAY_OVERLAY_SESSION_KEY)) return false;\n\n      if (document.getElementsByClassName("truste_overlay").length > 0) { return false; }\n\n      return true;\n  }\n\n  function setupSCCEventListener() {\n      sccEventListener.configInfo = {server_config: server_config, loader_config: loader_config};\n      sccEventListener.startListener();\n  }\n\n  function displayEngagement(overlayRule) {\n      if (!canDisplayChatOverlay()) return;\n\n      var ruleToUse = overlayRule || server_config.overlay_rule;\n      sccChatState.sccOverlayRule = ruleToUse;\n\n\t  var popupServiceUrl = server_config.popupURL ? server_config.popupURL : loader_config.popupURL;\n\t  if (!popupServiceUrl) { // backward compatibility\n\t\t  popupServiceUrl =\n\t\t    (server_config.chatBrainURL ? server_config.chatBrainURL : loader_config.chatBrainURL)\n\t\t\t+ \'popup\';\n\t  }\n\n      $.magnificPopup.open({\n          items: {\n              src: popupServiceUrl + \'?rule=\' + ruleToUse,\n              type: \'iframe\'\n          },\n          closeOnBgClick: true,\n          enableEscapeKey: true,\n\xa0\xa0\xa0       showCloseBtn: false,\n          callbacks: {\n              open: function () {\n                  $(this.container).find(\'.mfp-iframe\').css(\'background\', \'transparent\').css(\'box-shadow\', \'none\');\n                  if($(\'body\').hasClass(\'pdfAssetDetail\') || $(\'body\').hasClass(\'videoAssetDetail\')) {\n                    $(\'head\').append( $(\'<link rel="stylesheet" type="text/css" />\').attr(\'href\', \'/etc.clientlibs/sapdx/clientlibs/clientlib-common/clientlib-common-react.min.css\') );\n                  }\n              },\n              close: function () {\n              }\n          }\n      });\n\n      sessionStorage.setItem(DISPLAY_OVERLAY_SESSION_KEY, true);\n      let overlayType = "";\n      if (sccEventListener.configInfo.server_config.popup_source.indexOf("lead_prediction") !== -1) {\n          overlayType = "Predictive-URL";\n      } else if (sccEventListener.configInfo.server_config.popup_source === "timeout") {\n          overlayType = "Time out on Page";\n      }\n\n      triggerSCCTrackingEvent("sccChatInviteDisplayed", "overlay", {\n              rule: sccChatState.sccOverlayRule,\n              queueaddress: server_config.queueaddress,\n              chat_source: server_config.popup_source,\n              retry: pending_chat_invite ? true : null,\n              name: overlayType\n          });\n      pending_chat_invite = false;\n  }\n\n  function tryDisplayEngagement(source) {\n    //sccLog(" tryDisplayEngagement is triggerd by",  source ? source : "timeout");\n    if (server_config.overlay_rule && agentAvailable(sccQeueuStatuses)) {\n      sccLog("[SCC Debug]triggerring the overlay event: on", source ? source : "timeout" );\n      if (source) server_config.popup_source = source;\n      else delete server_config.popup_source;\n\n      displayEngagement();\n    }\n  }\n\n  function monitorSCCQueue() {\n      if (Object.keys(server_config.queues_to_watch).length === 0) {\n          enableChatNowForSCCClient(true);\n      }\n\n      if (Object.keys(server_config.queues_to_watch).length > 0 || server_config.overlay_rule) {\n        //need a timer\n        queueWatcher.addQueues(server_config.queues_to_watch, checkSCCAvailability);\n        queueWatcher.startWatcher();\n\n        sccTimer.addCallback(IDLE_TIMEOUT_IN_MILS, function() { tryDisplayEngagement("timeout"); });\n        sccTimer.startTimer();\n      }\n  }\n\n  function agentAvailable(statuses) {\n      if (Object.keys(server_config.queues_to_watch).length === 0) return true; //TODO: Review\n\n      if (!statuses) return false;\n\n      for (var key in server_config.queues_to_watch) {\n          if (statuses[key] === true) {\n              return true;\n          }\n      }\n\n      return false;\n  }\n\n  function checkSCCAvailability(data) {\n    sccQeueuStatuses = data;\n    var available = agentAvailable(data);\n    enableChatNowForSCCClient(available);\n  }\n\n  var videoIDs = ["56cc2135-b37d-0010-87a3-c30de2ffd8ff", "64f02135-b37d-0010-87a3-c30de2ffd8ff", "24120f34-b37d-0010-87a3-c30de2ffd8ff"];\n  $(document).on(\'videoStateChanged\', function (event, args) {\n      sccLog("videoStateChanged", args);\n      if (args && args.videoState == "ended" && agentAvailable(sccQeueuStatuses)) {\n        if (args.videoID && videoIDs.indexOf(args.videoID) >= 0) {\n          displayEngagement("video-inside-track-global");\n        } else if (pending_chat_invite) {\n          setTimeout(displayEngagement, 5000);\n        }\n      }\n  });\n\n  function resetLastSetTime() {\n    sccTimer.resetLastSetTime(IDLE_TIMEOUT_IN_MILS);\n  }\n\n  function setupDOMEventListeners() {\n      sccLog("[SCC Debug]setupDOMEventListeners");\n      document.addEventListener("click", resetLastSetTime);\n      document.addEventListener("mousemove", resetLastSetTime);\n      document.addEventListener("mousedown", resetLastSetTime);\n      document.addEventListener("touchstart", resetLastSetTime);\n      document.addEventListener("keypress", resetLastSetTime);\n      window.addEventListener("scroll", resetLastSetTime);\n  }\n\n  if (server_config.overlay_rule) {\n      sccWatchVideoPlayer();\n\n      setupDOMEventListeners()\n  }\n\n  if (server_config.chatActive) {\n    enableChatNowForSCCClient(false);\n    loadCAIBot(true);\n  } else if (loader_config.loadImmediate) {\n      enableChatNowForSCCClient(true);\n      if (loader_config.loadDialog) {\n          setTimeout(openSCCClient, 1000);\n          triggerSCCTrackingEvent("sccChatOpenOffsite", "offsite", {rule: loader_config.rule, queueaddress: server_config.queueaddress});\n      }\n  } else {\n      monitorSCCQueue();\n  }\n\n  setupSCCEventListener();\n\n  document.addEventListener("SCCChatClosed", function(e) {\n    if (e.detail == server_config) {\n      monitorSCCQueue();\n    }\n  });\n\n  sccLog("[SCC Debug]listening to PossibleChatLead");\n  document.addEventListener("PossibleChatLead", function(e) {\n    sccLog("[SCC Debug]receiving chat lead trigger");\n    triggerSCCTrackingEvent("sccChatLeadTriggered", "lead_prediction", e.detail);\n    var prediction = "lead_prediction:" + (e.detail["chat-helper-version"] || "unknown") + ";score:" +  (e.detail["user-effect"] || "unknown");\n    tryDisplayEngagement(prediction);\n  });\n\n  document.dispatchEvent(createEvent(\'ChatLeadListenerReady\', {}));\n\n  document.addEventListener("OpenLocalChatSCCClient", function(e) {\n    openSCCClient();\n  });\n}\n\nvar contactUsLinkCss = ".InContactModule__item--hZMKr";\n\nfunction startSCCGlobalChat(config, loader_config) {\n  sccLog("starting global chat:",config);\n\n  var isRTLSite = $(\'html.rtl\').length > 0;\n    var global_chat_now =  \'<div id="global_chat_on" class="InContactModule__item--hZMKr"><div class="InContactModule__row--R5A2l"><div class=""><div class="Image__imageInContactModule--Zhb0M"><div class="Image__wrapper--g1IpI"><div><picture class="Image__pictureAlignment--ceI11" style="position: static;"><img loading="lazy" class="" src="/dam/application/imagelibrary/icons/299000/299224-discussion-2-icon-grey8.svg/299224-discussion-2-icon-grey8.svg" alt=""></picture></div></div></div></div><div class="InContactModule__textContainer--YWBYl"><a class="Title__onlineInContactModule--CkMtv fontRegular fontBP" target="_self" rel="nofollow" role="link" tabindex="0"><p class="Body__root--FCOOV Title__footerText--NRkCg Body__s--WnySF Body__color--Aj694">Chat now</p></a><p class="Body__root--FCOOV Text__textInContactModule--Fu0qt Body__xs--BBksH Body__color--Aj694">(English Only)<br>Get live help and chat with an SAP representative.&lrm;</p></div></div></div>\';\n    if (isRTLSite) {\n      global_chat_now =  \'<div id="global_chat_on" class="InContactModule__item--hZMKr"><div class="InContactModule__row--R5A2l" style="text-align: left"><div class=""><div class="Image__imageInContactModule--Zhb0M"><div class="Image__wrapper--g1IpI"><div><picture class="Image__pictureAlignment--ceI11" style="position: static;"><img loading="lazy" class="" src="/dam/application/imagelibrary/icons/299000/299224-discussion-2-icon-grey8.svg/299224-discussion-2-icon-grey8.svg" alt=""></picture></div></div></div></div><div class="InContactModule__textContainer--YWBYl"><a class="Title__onlineInContactModule--CkMtv fontRegular fontBP" target="_self" rel="nofollow" role="link" tabindex="0"><p class="Body__root--FCOOV Title__footerText--NRkCg Body__s--WnySF Body__color--Aj694">Chat now</p></a><p class="Body__root--FCOOV Text__textInContactModule--Fu0qt Body__xs--BBksH Body__color--Aj694">(English Only)<br>Get live help and chat with an SAP representative.&lrm;</p></div></div></div>\';\n    }\n\n    var global_chat_offline = \'<div ="global_chat_off" class="InContactModule__item--hZMKr"><div class="InContactModule__row--R5A2l"><div class=""><div class="Image__imageInContactModule--Zhb0M"><div class="Image__wrapper--g1IpI"><div><picture class="Image__pictureAlignment--ceI11" style="position: static;"><img loading="lazy" class="" src="/dam/application/imagelibrary/icons/299000/299224-discussion-2-icon-grey8.svg/299224-discussion-2-icon-grey8.svg" alt=""></picture></div></div></div></div><div class="InContactModule__textContainer--YWBYl"><p class="Body__root--FCOOV Title__footerText--NRkCg Body__s--WnySF Body__color--Aj694"><span class="fontBook fontBP">Chat Offline</span></p><p class="Body__root--FCOOV Text__textInContactModule--Fu0qt Body__xs--BBksH Body__color--Aj694">(English Only)<br>Get live help and chat with an SAP representative.&lrm;</p></div></div></div>\';\n    if (isRTLSite) {\n      global_chat_offline = \'<div ="global_chat_off" class="InContactModule__item--hZMKr"><div class="InContactModule__row--R5A2l" style="text-align: left"><div class=""><div class="Image__imageInContactModule--Zhb0M"><div class="Image__wrapper--g1IpI"><div><picture class="Image__pictureAlignment--ceI11" style="position: static;"><img loading="lazy" class="" src="/dam/application/imagelibrary/icons/299000/299224-discussion-2-icon-grey8.svg/299224-discussion-2-icon-grey8.svg" alt=""></picture></div></div></div></div><div class="InContactModule__textContainer--YWBYl"><p class="Body__root--FCOOV Title__footerText--NRkCg Body__s--WnySF Body__color--Aj694"><span class="fontBook fontBP">Chat Offline</span></p><p class="Body__root--FCOOV Text__textInContactModule--Fu0qt Body__xs--BBksH Body__color--Aj694">(English Only)<br>Get live help and chat with an SAP representative.&lrm;</p></div></div></div\';\n    }\n\n  var server_config = config.server_config;\n  server_config.queues_to_watch = server_config.queues_to_watch || {};\n\n  var chatBrainURL = server_config.chatBrainURL ? server_config.chatBrainURL : loader_config.chatBrainURL;\n  var availabilityServiceUrl = server_config.agentAvailabilityURL ? server_config.agentAvailabilityURL : loader_config.agentAvailabilityURL;\n  if (!availabilityServiceUrl) { // backward compatibility\n    availabilityServiceUrl = chatBrainURL;\n  }\n\n  queueWatcher.availabilityServiceUrl = availabilityServiceUrl;\n  queueWatcher.chatBrainURL = chatBrainURL;\n  queueWatcher.timerTimeoutInMils = loader_config.timerTimeoutInMils;\n\n  var sccQeueuStatuses = {};\n\n  function openSCCClient() {\n    sccLog("[SCC Debug]opening global chat: ", server_config);\n    cvcWrapper.openSCCClient("", server_config, loader_config);\n  }\n\n  function loadCAIBot(showCVC) {\n    sccLog("[SCC Debug]loading global chat");\n    cvcWrapper.loadCVC(showCVC, server_config, loader_config);\n  }\n\n  //update handlers on online/offline links\n  function enableChatNowForSCCClient(online) {\n      sccLog("global enableChatNowForSCCClient:", online);\n      function addOrRemoveElementWithClickHandler(add, id, handler) {\n        if (add) {\n            if(handler) $(\'html\').on(\'click\', id, handler);\n        } else {\n            if(handler) $(\'html\').off(\'click\', id, handler);\n            $(id).remove();\n        }\n      }\n\n      if (online) {\n        addOrRemoveElementWithClickHandler(false, "#global_chat_on", openSCCClient);\n        if($(\'#global_chat_on\').length == 0) {\n          setTimeout(function() {\n            sccLog("loading global chat now", $(contactUsLinkCss).length);\n            \n                if (isRTLSite)\n                  $(contactUsLinkCss).removeClass("InContactModule__oneItem--v2NZ4").removeClass("InContactModule__twoItemsRtl--nzdy8").addClass("InContactModule__threeItemsRtl--vu1Ch")\n                else \n                  $(contactUsLinkCss).removeClass(\'InContactModule__oneItem--v2NZ4\').removeClass(\'InContactModule__twoItems--qGIp7\').addClass(\'InContactModule__threeItems--p8HzK\');\n            \n\n            if($(\'#global_chat_on\').length == 0) {\n              if ($(\'#global_chat_off\').length > 0) {\n                addOrRemoveElementWithClickHandler(false, "#global_chat_off");\n              }\n\n              if (!$(\'#global_chat_on\').is(":visible"))\n                $(global_chat_now).insertBefore($($(contactUsLinkCss)[$(contactUsLinkCss).length - 1]));\n\n                addOrRemoveElementWithClickHandler(true, "#global_chat_on", openSCCClient);\n            }\n          }, 300);\n        }\n\n        loadCAIBot();\n\n      } else {\n        addOrRemoveElementWithClickHandler(false, \'#global_chat_off\');\n        if ($(\'#global_chat_off\').length == 0) {\n          setTimeout(function() {\n                if (isRTLSite)\n                  $(contactUsLinkCss).removeClass("InContactModule__oneItem--v2NZ4").removeClass("InContactModule__twoItemsRtl--nzdy8").addClass("InContactModule__threeItemsRtl--vu1Ch")\n                else \n                  $(contactUsLinkCss).removeClass(\'InContactModule__oneItem--v2NZ4\').removeClass(\'InContactModule__twoItems--qGIp7\').addClass(\'InContactModule__threeItems--p8HzK\');\n              \n\n            if ($(\'#global_chat_on\').length > 0) {\n                addOrRemoveElementWithClickHandler(false, \'#global_chat_on\', openSCCClient)\n            } \n            if (!$(\'#global_chat_off\').is(":visible"))\n                $(global_chat_offline).insertBefore($($(contactUsLinkCss)[$(contactUsLinkCss).length - 1]));\n          }, 300);\n        }\n      }\n  }\n\n  function setupSCCEventListener() {\n      sccEventListener.configInfo = {server_config: server_config, loader_config: loader_config};\n      sccEventListener.startListener();\n  }\n\n  function monitorSCCQueue() {\n      if (Object.keys(server_config.queues_to_watch).length === 0) {\n          enableChatNowForSCCClient(true);\n      }\n\n      if (Object.keys(server_config.queues_to_watch).length > 0 || server_config.overlay_rule) {\n        //need a timer\n        queueWatcher.addQueues(server_config.queues_to_watch, checkSCCAvailability);\n        queueWatcher.startWatcher();\n      }\n  }\n\n  function agentAvailable(statuses) {\n      if (Object.keys(server_config.queues_to_watch).length === 0) return true; //TODO: Review\n\n      if (!statuses) return false;\n\n      for (var key in server_config.queues_to_watch) {\n          if (statuses[key] === true) {\n              return true;\n          }\n      }\n\n      return false;\n  }\n\n  function checkSCCAvailability(data) {\n    sccQeueuStatuses = data;\n    var available = agentAvailable(data);\n    enableChatNowForSCCClient(available);\n  }\n\n  if (server_config.chatActive) {\n    enableChatNowForSCCClient(false);\n    loadCAIBot(true);\n  } else {\n      monitorSCCQueue();\n  }\n\n  setupSCCEventListener();\n\n  document.addEventListener("SCCChatClosed", function(e) {\n    if (e.detail == server_config) {\n      monitorSCCQueue();\n    }\n  });\n\n  document.addEventListener("ContactModuleOpen", function() {\n    sccLog("in ContactModuleOpen handler:", sccQeueuStatuses);\n    enableChatNowForSCCClient(agentAvailable(sccQeueuStatuses));\n  });\n  \n  document.addEventListener("cxsdsHeaderClickTracker", function(event) {\n    if (event.detail && event.detail.title === "Open Mobile Contact Us") {\n      sccLog("in ContactModuleOpen handler:", sccQeueuStatuses);\n      enableChatNowForSCCClient(agentAvailable(sccQeueuStatuses));\n    }\n  });\n}\n\nfunction resumeSCCChat(config, loader_config) {\n  sccLog("resume chat:");\n\n  var server_config = config.server_config;\n  server_config.queues_to_watch = server_config.queues_to_watch || {};\n\n  function openSCCClient() {\n    sccLog("[SCC Debug]opening global chat");\n    cvcWrapper.openSCCClient("", server_config, loader_config);\n  }\n\n  function loadCAIBot(showCVC) {\n    sccLog("[SCC Debug]loading global chat");\n    cvcWrapper.loadCVC(showCVC, server_config, loader_config);\n  }\n\n  function setupSCCEventListener() {\n      sccEventListener.configInfo = {server_config: server_config, loader_config: loader_config};\n      sccEventListener.startListener();\n  }\n\n  loadCAIBot(true);\n  setupSCCEventListener();\n  document.addEventListener("SCCChatClosed", function(e) {\n    if (e.detail == server_config) {\n    }\n  });\n\n  cvcWrapper.sccClientOpened = true;\n}\n\n\nfunction sccWatchVideoPlayer() {\n  var VIDEO_PLAYER_STATES = ["not playing", "playing", "paused", "ended"];\n\n  var VIDEO_PLAYING_EVENT = "VideoPlayingEvent";\n  var VIDEO_PAUSE_EVENT = "VideoPauseEvent";\n  var VIDEO_ENDED_EVENT = "VideoEndedEvent";\n\n  function triggerVideoEvent(eventName, videoID) {\n      window.videoState = "";\n\n      if (eventName == VIDEO_PLAYING_EVENT) {\n          window.videoState = "playing";\n      } else if (eventName == VIDEO_PAUSE_EVENT) {\n          window.videoState = "paused";\n      } else if (eventName == VIDEO_ENDED_EVENT) {\n          window.videoState = "ended";\n      }\n\n      SAP.sapdx.analytics.datalayer.triggerEvent("videoStateChanged", { videoState: window.videoState, videoID: videoID });\n  }\n\n  $("video").on("play", null, function () {\n      triggerVideoEvent(VIDEO_PLAYING_EVENT, this.getAttribute(\'data-asset-id\'));\n  });\n\n  $("video").on("pause", null, function () {\n      triggerVideoEvent(VIDEO_PAUSE_EVENT, this.getAttribute(\'data-asset-id\'));\n  });\n\n  $("video").on("ended", null, function () {\n      triggerVideoEvent(VIDEO_ENDED_EVENT, this.getAttribute(\'data-asset-id\'));\n  });\n\n  $(\'html\').on(\'playerInitialized\', function (e, videoId) {\n      var player = !!videoId ? videojs.players[videoId] : null;\n      if (!!player) {\n          player.ready(function () {\n              player.on(\'play\', function () {\n                  triggerVideoEvent(VIDEO_PLAYING_EVENT, player.getAttribute(\'data-asset-id\'));\n              });\n              player.on(\'pause\', function () {\n                  triggerVideoEvent(VIDEO_PAUSE_EVENT, player.getAttribute(\'data-asset-id\'));\n              });\n              player.on(\'ended\', function () {\n                  triggerVideoEvent(VIDEO_ENDED_EVENT, player.getAttribute(\'data-asset-id\'));\n              });\n          }, true);\n      }\n  });\n}\n\n\nvar WAIT_FOR_DOM_ELEMENT_IN_MILS = 10000;\n\nvar sccWaiter = {\n  callbacks: {},\n  addCallback: function(styleKey, callback) {\n    this.callbacks[styleKey] = callback;\n  },\n  started: false,\n  stopped: false,\n  observer: null,\n  startWait: function () {\n      if (this.started) return;\n\n      this.stopped = false;\n      var targetNode = window.sccLoaderConfig && window.sccLoaderConfig.isMobile ? document.getElementById(\'page\') : document.getElementById(\'main\');\n\n      var that = this;\n\n      if (targetNode) {\n        sccLog("[SCC Debug] wait for DOM elements to show up");\n        //sccTimer.addCallback(WAIT_FOR_DOM_ELEMENT_IN_MILS, sccWaiter.stopWait);\n        //sccTimer.startTimer();\n        \n        for (styleKey in that.callbacks) {\n            if (document.querySelectorAll(styleKey).length > 0) {\n              that.callbacks[styleKey](false);\n              delete that.callbacks[styleKey];\n            }\n          }\n\n        var config = { childList: true, subtree: true };\n\n        var callback = function(mutationsList, observer) {\n          for (styleKey in that.callbacks) {\n            if (document.querySelectorAll(styleKey).length > 0) {\n              that.callbacks[styleKey](false);\n              delete that.callbacks[styleKey];\n            }\n          }\n\n          if (Object.keys(that.callbacks).length == 0) {\n              that.observer.disconnect();\n              that.stopWait();\n          } else if (that.stopped) {\n            for (styleKey in that.callbacks) {\n                that.callbacks[styleKey](true);\n                delete that.callbacks[styleKey];\n            }\n\n            that.observer.disconnect();\n          }\n        };\n\n        var observer = new MutationObserver(callback);\n        observer.observe(document, config);\n        sccWaiter.observer = observer;\n\n        this.started = true;\n      } else {\n        for (styleKey in that.callbacks) {\n            that.callbacks[styleKey](true);\n            delete that.callbacks[styleKey];\n        }\n\n        that.stopped = true;\n      }\n  },\n  stopWait: function() {\n    if (sccWaiter.stopped) return;\n\n    sccWaiter.stopped = true;\n    sccTimer.removeCallback(WAIT_FOR_DOM_ELEMENT_IN_MILS, sccWaiter.stopWait);\n  }\n};\n\n\nfunction setUpLocalChat(timeIsUp) {\n  //wait for .dtm_live-chat element\n  if ($(\'.dtm-live-chat\').length == 0)  {\n    if (timeIsUp) return;\n\n    sccWaiter.addCallback(\'.dtm-live-chat\', setUpLocalChat);\n    sccWaiter.startWait();\n    return;\n  }\n\n\n  if ($(\'.dtm-live-chat\').length > 0) {\n      var config_URL = window.sccLoaderConfig.chatBrainURL + "config?site=" + window.sccLoaderConfig.site + "&country=" + window.sccLoaderConfig.country + "&path=" + window.location.pathname;\n      if (window.sccLoaderConfig.collection) {\n          config_URL += "&collection=" + window.sccLoaderConfig.collection;\n      }\n\n      if (window.sccLoaderConfig.rule) {\n        config_URL += "&rule=" + window.sccLoaderConfig.rule;\n      }\n\n      if (window.sccLoaderConfig.campaigncode) {\n        config_URL += "&campaigncode=" + window.sccLoaderConfig.campaigncode;\n      }\n\n      if (window.sccLoaderConfig.chatoffsite) {\n        config_URL += "&chatoffsite=" + window.sccLoaderConfig.chatoffsite;\n      }\n\n      try {\n        var employee_count = +_satellite.getVar(\'localStorage - _6senseCompanyDetails\').company.employee_count;\n        if (employee_count >= 1 && employee_count <= 1000)\n          config_URL += "&employee_count=1000";\n      } catch(ex) {}\n\n      //if(window.sccLoaderConfig.sitecode) {\n      //  config_URL += "&sitecode=" + window.sccLoaderConfig.sitecode;\n      //}\n\n      //var SCC_CONFIG_RECORD = "sccConfigRecordEvent";\n      $.getJSON(config_URL + "&r=" + Math.random(), function( data ) {\n          if (data.queueaddress && (SAP.DTM.runMode != "prod" || getQueryParameter(\'scc-test\') || !data.disabled)) {\n              window.sccLoaderConfig.useSCC = true;\n\n              //if (!data.queues_to_watch || Object.keys(data.queues_to_watch).length == 0) {\n              //  data.queues_to_watch = {"sales-sap-general-global-en@sap.com": "sales-sap-general-global-en"};\n              //}\n\n              var config = {};\n              config.server_config = data;\n\n              if (window.sccLoaderConfig.chatautostart) {\n                  window.sccLoaderConfig.loadImmediate = true;\n                  window.sccLoaderConfig.loadDialog = true;\n              }\n\n              startSCCLocalChat(config, window.sccLoaderConfig);\n\n              //SCC.saveConfigInfo(data);\n\n              recordChatbrainConfig(config_URL, 200, data);\n          } else {\n            //triggerSCCTrackingEvent(SCC_NOT_FIRED_EVENT, "sccLoadIssue", {reason: "no queue available or disabled", disabled: data.disabled});\n            sccLog("not serving chat");\n          }\n      }, function() {\n          sccLog("retrieving configuration failed:");\n          //triggerSCCTrackingEvent(SCC_NOT_FIRED_EVENT, "sccLoadIssue", {reason: "error retrieving config"});\n      }).error(function(e) {;\n            recordChatbrainConfig(config_URL, e.status);\n            sccLog("error:",e.status, e.responseText);\n      });\n  }\n}\n\nfunction setupHandraiserChat() {\n   var extracaddataParam = getQueryParameter(\'extracaddata\');\n   var handraiserConfig = JSON.parse(localStorage.getItem(\'chatAgentConfig\'));\n   var extraCadData = JSON.parse(localStorage.getItem(\'extraCadData\'));\n   var isHandraiserFlow = extracaddataParam && handraiserConfig && extraCadData;\n  \n   if (!isHandraiserFlow) {\n     return;\n   }\n  \n  loadAndStartChat(handraiserConfig, extraCadData);\n}\n\n/**\n * A custom component that helps to maintain chat invite popup display logic.\n */\nconst chatInvitePopupHandler = {\n  chatbrainConfig: {},\n  pendingChatInvite: false,\n  canDisplayChatInvitePopup: () => {\n    if (cvcWrapper.sccClientOpened) return false;\n    if (window.location.pathname.indexOf(\'/discover/\') >= 0) return false;\n    if (window.location.pathname.indexOf(\'/events/sapphire.html\') >= 0) return false;\n    if (window.location.pathname.indexOf(\'/integrated-reports/\') >= 0\n        || window.location.pathname.indexOf(\'/investors/\') >= 0\n        || window.location.pathname.indexOf(\'/products/sme-business-software/hr.html\') == 0) return false;\n    \n    var isFromSAP = _satellite.getVar("isFromSAP");\n    if (isFromSAP && isFromSAP()) return false;\n    // if (loader_config.isMobile) return false;\n    if (top !== window) return false; //do not display the overlay in a child window\n    if (window.videoState == "playing" || window.videoState == "paused") {\n      chatInvitePopupHandler.pendingChatInvite = !!chatInvitePopupHandler.chatbrainConfig.popup_source;\n      return false; //don\'t display the overlay when video is being played\n    }\n    if (SAP.wcms.sapdx.page.lightBox.pageRating && (SAP.wcms.sapdx.page.lightBox.pageRating.isVideoLightbox && !SAP.wcms.sapdx.page.lightBox.pageRating.isVideoLightbox()) && $.magnificPopup.instance.isOpen) {\n      chatInvitePopupHandler.pendingChatInvite = !!chatInvitePopupHandler.chatbrainConfig.popup_source;\n      return false;\n    }\n    if ($(\'video\').length > 0 && $(\'video\').toArray().some((v) => { return !v.paused && !v.ended; })) {\n      chatInvitePopupHandler.pendingChatInvite = !!chatInvitePopupHandler.chatbrainConfig.popup_source;\n      return false;\n    }\n    if (sessionStorage.getItem(DISPLAY_OVERLAY_SESSION_KEY)) return false;\n    if (document.getElementsByClassName("truste_overlay").length > 0) { return false; }\n    \n    return true;\n  },\n  tryDisplayEngagement: (source) => {\n    if (chatInvitePopupHandler.chatbrainConfig.overlay_rule && chatInvitePopupHandler.chatbrainConfig.popupURL) {\n      sccLog("[SCC Debug]triggerring the overlay event: on", source ? source : "timeout" );\n      if (source) chatInvitePopupHandler.chatbrainConfig.popup_source = source;\n      else delete chatInvitePopupHandler.chatbrainConfig.popup_source;\n\n      chatInvitePopupHandler.displayEngagement();\n    }\n  },\n  displayEngagement: () => {\n    if (!chatInvitePopupHandler.canDisplayChatInvitePopup()) return;\n    sccChatState.sccOverlayRule = chatInvitePopupHandler.chatbrainConfig.overlay_rule;\n    $.magnificPopup.open({\n        items: {\n          src: `${chatInvitePopupHandler.chatbrainConfig.popupURL}?rule=${chatInvitePopupHandler.chatbrainConfig.overlay_rule}`,\n          type: \'iframe\'\n        },\n        closeOnBgClick: true,\n        enableEscapeKey: true,\n        showCloseBtn: false,\n        callbacks: {\n          open: function () {\n              $(this.container).find(\'.mfp-iframe\').css(\'background\', \'transparent\').css(\'box-shadow\', \'none\');\n              if($(\'body\').hasClass(\'pdfAssetDetail\') || $(\'body\').hasClass(\'videoAssetDetail\')) {\n                $(\'head\').append( $(\'<link rel="stylesheet" type="text/css" />\').attr(\'href\', \'/etc.clientlibs/sapdx/clientlibs/clientlib-common/clientlib-common-react.min.css\') );\n              }\n          },\n          close: function () {}\n        }\n    });\n\n    sessionStorage.setItem(DISPLAY_OVERLAY_SESSION_KEY, true);\n    let overlayType = "";\n    if (chatInvitePopupHandler.chatbrainConfig.popup_source.indexOf("lead_prediction") !== -1) {\n        overlayType = "Predictive-URL";\n    } else if (chatInvitePopupHandler.chatbrainConfig.popup_source === "timeout") {\n        overlayType = "Time out on Page";\n    }\n\n    triggerSCCTrackingEvent("sccChatInviteDisplayed", "overlay", {\n      rule: sccChatState.sccOverlayRule,\n      queueaddress: chatInvitePopupHandler.chatbrainConfig.queueaddress,\n      chat_source: chatInvitePopupHandler.chatbrainConfig.popup_source,\n      retry: chatInvitePopupHandler.pendingChatInvite ? true : null,\n      name: overlayType\n    });\n    chatInvitePopupHandler.pendingChatInvite = false;\n  }\n};\n\n// Method is used to register event listeners related to the Product Advisor when local chat is disabled.\nfunction setupProductAdvisorChat() {\n  const chatbrainConfigUrl = `${window.sccLoaderConfig.chatBrainURL}config?site=${window.sccLoaderConfig.site}&country=${window.sccLoaderConfig.country}&path=${window.location.pathname}&r=${Math.random()}`\n  \n  // Setup event listener that detects chat lead and triggers chat invite popup to connect the user with Sinch Agent.\n  const setupChatLeadListener = () => {\n    sccLog("[SCC Debug]listening to PossibleChatLead");\n    document.addEventListener("PossibleChatLead", (e) => {\n      sccLog("[SCC Debug]receiving chat lead trigger");\n      triggerSCCTrackingEvent("sccChatLeadTriggered", "lead_prediction", e.detail);\n      const prediction = "lead_prediction:" + (e.detail["chat-helper-version"] || "unknown") + ";score:" +  (e.detail["user-effect"] || "unknown");\n      chatInvitePopupHandler.tryDisplayEngagement(prediction);\n    });\n    document.dispatchEvent(createEvent(\'ChatLeadListenerReady\', {}));\n  }\n\n  const setupOneMinuteTimerForChatInvitePopup = () => {\n    sccTimer.addCallback(IDLE_TIMEOUT_IN_MILS, () => { chatInvitePopupHandler.tryDisplayEngagement("timeout"); });\n    sccTimer.startTimer();\n  }\n\n  const resetLastSetTime = () => {\n    sccTimer.resetLastSetTime(IDLE_TIMEOUT_IN_MILS);\n  }\n\n  const setupSCCEventListener = () => {\n    sccEventListener.configInfo = { server_config: chatInvitePopupHandler.chatbrainConfig, loader_config: window.sccLoaderConfig };\n    sccEventListener.startListener();\n  }\n\n  // Register DOM event listeners to detect user activity on the page and reset the timer.\n  const setupDOMEventListeners = () => {\n    sccLog("[SCC Debug]setupDOMEventListeners");\n    document.addEventListener("click", resetLastSetTime);\n    document.addEventListener("mousemove", resetLastSetTime);\n    document.addEventListener("mousedown", resetLastSetTime);\n    document.addEventListener("touchstart", resetLastSetTime);\n    document.addEventListener("keypress", resetLastSetTime);\n    window.addEventListener("scroll", resetLastSetTime);\n  }\n  \n  // Sends request to chatbrain /config endpoint to retrieve server config for the page.\n  // This information may contain information about overlay name that should be dispalyed to the user.\n  $.getJSON(chatbrainConfigUrl, (data) => {\n    // The overlay_rule property contains the popup name associated with the current page.\n    // If this property is not specified, there is no need to register event listeners.\n    if (data.overlay_rule) {\n      chatInvitePopupHandler.chatbrainConfig = data;\n      // setupOneMinuteTimerForChatInvitePopup();\n      setupSCCEventListener();\n      setupChatLeadListener();\n      // setupDOMEventListeners();\n    } else {\n      sccLog("[SCC Debug]not serving chat");\n    }\n  }, () => {\n    sccLog("[SCC Debug]retrieving configuration failed:");\n  }).error((e) => {\n    recordChatbrainConfig(chatbrainConfigUrl, e.status);\n    sccLog("[SCC Debug]error:", e.status, e.responseText);\n  });\n};\n\nfunction setupGlobalChat(timeIsUp) \n{\n  if ($(contactUsLinkCss).length == 0)  {\n    sccLog("DOM element is not available:", contactUsLinkCss);\n    if (timeIsUp) sccLog("After 10 seconds, we are not enabling global chat");\n    if (timeIsUp) return;\n\n    sccWaiter.addCallback(contactUsLinkCss, setupGlobalChat);\n    sccWaiter.startWait();\n    return;\n  }\n\n  if (($(\'html\').attr(\'lang\') || \'en\').toLowerCase() != \'en\') {\n    var config_URL = window.sccLoaderConfig.chatBrainURL + "config?site=" + window.sccLoaderConfig.site + "&country=" + window.sccLoaderConfig.country + "&path=" + window.location.pathname + "&collection=englishonlybotchat";\n    $.getJSON(config_URL + "&r=" + Math.random(), function( data ) {\n        if (data.queueaddress && (data.language || "").toLowerCase() == \'en\') {\n          var config = {};\n          config.server_config = data;\n          data.global_english_chat_support = true;\n          startSCCGlobalChat(config, window.sccLoaderConfig);\n        } else {\n          //triggerSCCTrackingEvent(SCC_NOT_FIRED_EVENT, "sccLoadIssue", {reason: "no queue available or disabled", disabled: data.disabled});\n          sccLog("not serving chat");\n        }\n    }, function() {\n        sccLog("retrieving configuration failed:");\n        //triggerSCCTrackingEvent(SCC_NOT_FIRED_EVENT, "sccLoadIssue", {reason: "error retrieving config"});\n    }).error(function(e) {;\n          recordChatbrainConfig(config_URL, e.status);\n          sccLog("error:",e.status, e.responseText);\n    });\n  }\n}\n\n\nfunction sccLoadChatClient() {\n  $("<style type=\'text/css\'> div#cvc-container iframe:first-child { display: none; } </style>").appendTo("head");\n  $("<style type=\'text/css\'> iframe#cvc-frame { border-radius: 8px 8px 0 0 !important; } iframe#cvc-frame:dir(rtl) {right: unset !important; left: 1%; }</style>").appendTo("head");\n\n  window.sccLoaderConfig = {\n      useSCC: false,\n      loadImmediate: false,\n      loadDialog: false,\n      timerTimeoutInMils: 30 * 1000,\n      landscape: \'dev\',\n      site: sccSiteName,\n      country: (_satellite.cookie.get(\'country\') || "").toUpperCase(),\n      path: window.location.pathname,\n      chatBrainURL: \'https://api.services-qa.sap.com/chats/chat-brain/\',\n\t  popupURL: \'https://api.services-qa.sap.com/chats/popup\',\n\t  agentAvailabilityURL: \'https://api.services-qa.sap.com/chats/availability\',\n/*      chatBrainURL: \'https://chatbrain-dev.cfapps.eu10.hana.ondemand.com/\', */\n      campaigncode: getCampaigncode(),\n      sitecode: $(\'html\').data(\'site-code\'),\n      //chatActive: localStorage.getItem("cvc_active") === "true",\n      chatautostart: getQueryParameter(\'chatautostart\')\n  };\n\n  var lp_offsite = getQueryParameter(\'lp_offsite\');\n  if (!lp_offsite && _satellite.getVar("isConsentEnabled")("cai.tools.sap", 1)) {\n      var useragent = (window.navigator.userAgent || "").toLowerCase();\n      //if (useragent.indexOf("trident") >= 0) window.sccLoaderConfig.isIE = 1;\n      if (useragent.indexOf("mobile") >= 0) window.sccLoaderConfig.isMobile = 1;\n      //var notIE = useragent.indexOf("trident") < 0 || window.sccLoaderConfig.country == "IN";\n      //var notSafari = !((useragent.indexOf(\'iphone\') >= 0 || useragent.indexOf(\'ipad\') >= 0 || useragent.indexOf(\'ipod\') >= 0 || useragent.indexOf(\'macintosh\') >= 0) && useragent.indexOf(\'crios\') < 0 && useragent.indexOf(\'chrome\') < 0 && useragent.indexOf(\'firefox\') < 0);\n      //var notIOS = !(useragent.indexOf(\'iphone\') >= 0 || useragent.indexOf(\'ipad\') >= 0 || useragent.indexOf(\'ipod\') >= 0);\n      var pagePath = $(\'html\').data(\'page-path\');\n      var chatoffsite = getQueryParameter(\'chatoffsite\');\n      var extracaddata = getQueryParameter(\'extracaddata\');\n      var handraiserConfig = JSON.parse(localStorage.getItem(\'chatAgentConfig\'));\n\n      if (chatoffsite != "") {\n          if (!extracaddata || (extracaddata && handraiserConfig)) {\n            window.sccLoaderConfig.useSCC = true;\n            window.sccLoaderConfig.loadImmediate = true;\n\n            //window.sccLoaderConfig.rule = chatoffsite;\n            window.sccLoaderConfig.chatoffsite = chatoffsite;\n            window.sccLoaderConfig.loadDialog = true;\n          } \n      } else {\n          var arrLPvars = window.SAP && window.SAP.DTM && window.SAP.DTM.LivePerson && window.SAP.DTM.LivePerson.arrLPvars;\n\n          if (arrLPvars && arrLPvars.length) {\n\n              var site;\n              var collection;\n\n              arrLPvars.forEach(function (v) {\n                  if (v.name === \'Collection\') {\n                      collection = (v.value || "").toLowerCase();\n                  } else if (v.name === "Site") {\n                      site = (v.value || "").toLowerCase();\n                  }\n              });\n\n              window.sccLoaderConfig.collection = collection;\n          }\n      }\n\n      window.sccLoaderConfig.useSCC = true;\n\n      if (window.location.hostname == "www.sap.com") {\n          window.sccLoaderConfig.landscape = \'prod\';\n          window.sccLoaderConfig.chatBrainURL = \'https://api.services.sap.com/chats/chat-brain/\';\n      } else if (window.location.search.toLowerCase().indexOf(\'env=dev\') >= 0) {\n          window.sccLoaderConfig.landscape = \'dev\';\n      } else if (window.location.search.toLowerCase().indexOf(\'env=qa\') >= 0) {\n          window.sccLoaderConfig.landscape = \'qa\';\n          window.sccLoaderConfig.chatBrainURL = \'https://chatbrain-dev.cfapps.eu10.hana.ondemand.com/\';\n      } if (window.location.search.toLowerCase().indexOf(\'env=prod\') >= 0) {\n          window.sccLoaderConfig.landscape = \'prod\';\n          window.sccLoaderConfig.chatBrainURL = \'https://api.services.sap.com/chats/chat-brain/\';\n      }\n\n      if (window.location.search.toLowerCase().indexOf(\'scc-bot-qa\') >= 0) {\n          window.sccLoaderConfig.loadImmediate = true;\n          window.sccLoaderConfig.landscape = \'qa\';\n          window.sccLoaderConfig.chatBrainURL = \'https://chatbrain-test.cfapps.eu10.hana.ondemand.com/\';\n      } else if (window.location.search.toLowerCase().indexOf(\'scc-bot-prod\') >= 0) {\n          window.sccLoaderConfig.loadImmediate = true;\n          window.sccLoaderConfig.landscape = \'prod\';\n          window.sccLoaderConfig.chatBrainURL = \'https://api.services.sap.com/chats/chat-brain/\';\n      } else if (window.location.search.toLowerCase().indexOf(\'scc-bot\') >= 0) {\n          window.sccLoaderConfig.loadImmediate = true;\n          window.sccLoaderConfig.landscape = \'dev\';\n      }\n\n  }\n\n  //var SCC_NOT_FIRED_EVENT = "sccNotFired";\n  if (window.sccLoaderConfig.useSCC) {\n      if(localStorage.getItem("cvc_active") === "true" && top === window) {\n          //load the data from  sessionStorage\n          var data = SCC.loadConfigInfo();\n          if (data) {\n              var config = {};\n\n              data.chatActive = true;\n\n              window.sccLoaderConfig.useSCC = true;\n              config.server_config = data;\n              resumeSCCChat(config, window.sccLoaderConfig);\n          }\n      }\n\n      setUpLocalChat()\n\n      if(_satellite.getVar(\'isProductAdvisorEnabled\') !== undefined && _satellite.getVar(\'isProductAdvisorEnabled\') === false ) {\n        sccLog("setting up global chat...")\n        setupGlobalChat();\n      } else {\n        sccLog("skipping setting up global chat...")\n        sccLog("setting product advisor chat...")\n        setupProductAdvisorChat();\n      }\n    \n      setupHandraiserChat();\n\n  } else {\n    //triggerSCCTrackingEvent(SCC_NOT_FIRED_EVENT, "sccLoadIssue", {reason: "not use"});\n    sccLog("not serving chat");\n  }\n}\n\n$(document).ready(function() {\n    sccLog("sccLoadChatClient");\n    sccLoadChatClient();\n\n    if (window.sccLoaderConfig.landscape != \'prod\' && window.innerWidth < 767 && window.sccLoaderConfig.isMobile) {\n        var messaging = $(\'<a href="https://api.whatsapp.com/send?phone=5511970288810&text=Para%20iniciar%20a%20conversa%2C%20por%20favor%2C%20envie%20sua%20pergunta"><div id="textingoverlay"></div></a>\');\n            messaging.css({\n                right: "0px",\n                position: "fixed",\n                top: "45%",\n                marginTop: "-53px",\n                width: "31px",\n                height: "150px",\n                zIndex: "1000",\n                cursor: "pointer",\n                backgroundImage: "url(https://www.sap.com/content/dam/application/shared/images/contact-module/chat-whatsapp3.png)"\n            }).appendTo($(\'<div style="position: relative; border: solid;"></div>\').appendTo($(\'body\')));\n    }\n\n    var script = document.createElement("script");\n    script.src = "/dmc/scripts/bowser.min.js";\n    document.head.appendChild(script);\n});\n\nfunction setupCallMeNowSurvey() {\n    document.addEventListener(\'OpenCallMeNowSurvey\', (e) => openCallMeNowSurvey(e));\n}\n\nfunction openCallMeNowSurvey(e) {\n    const chatSurvey = document.getElementById(\'chat_survey\');\n\n    if (chatSurvey) {\n        return;\n    }\n\n    const surveyParameters = e.detail;\n\n    let src = prepareBaseSurveySrcForCallMeNow();\n    src = extendSrcWithRequiredParameters(src, surveyParameters);\n\n    if (surveyParameters.agentName || surveyParameters.queueName) {\n        src = extendSrcWithAdditionalParameters(src, surveyParameters);\n    }    openCallMeNowSurveyDialog(src);\n}\n\nfunction prepareBaseSurveySrcForCallMeNow() {\n    const surveyId = SAP.DTM.runMode != "prod" ? "SV_bQrT3mpRCQijox0" : "SV_8H8hSHkQRUA38Lb";\n    const currentPageUrl = encodeURIComponent(window.location.href);\n    const site = encodeURIComponent(window.location.host);\n    const country = document.cookie.split(\'; \').find((row) => row.startsWith(\'country=\'))?.split(\'=\')[1] || \'unknown\';    return `https://sapinsights.eu.qualtrics.com/jfe/form/${surveyId}?Site=${site}&CurrentPageURL=${currentPageUrl}&VisitorCountry=${country}`;\n}\n\nfunction extendSrcWithRequiredParameters(src, requiredParameters) {\n    const language = cvcWrapper?.configInfo?.server_config?.language;\n    const id = requiredParameters[\'responseId\'];\n    const queueAddress = encodeURIComponent(requiredParameters[\'queueId\']);\n    const chatUrl = encodeURIComponent(`https://cc-c1sccp1035467.cc.sinch.com/ecf/latest/communicationpanel/index.jsp#interactionid=${id}`);\n    const startTime = requiredParameters[\'startTime\'];\n    const endTime = requiredParameters[\'endTime\'];\n    const duration = Math.ceil((new Date(endTime) - new Date(startTime)) / 1000);    \n    src += `&original_contact_id=${id}&chat_url=${chatUrl}&QueueAddress=${queueAddress}&chatStartTime=${startTime}&chatEndTime=${endTime}&chatDuration=${duration}`;    \n  \n    if (language) {\n        src += `&Q_Language=${language}`;\n    }\n  \n    if(window.lastSurveyID) {\n        src += `&SurveyID=${window.lastSurveyID}`;\n    }\n\n    return src;\n}\n\nfunction extendSrcWithAdditionalParameters(src, additionalParameters) {\n    const agentNames = additionalParameters[\'agentNames\'] || [];\n    src += `&AgentName=${encodeURIComponent(agentNames.join(\'|\'))}`;\n    const queueName = encodeURIComponent(additionalParameters[\'queueName\'] || \'unknown\');\n    //agentNames.forEach(agentName => src += `&AgentName[]=${encodeURIComponent(agentName)}`);\n    src += `&QueueName=${queueName}&AgentChat=true`;\n    return src;\n}\n\nfunction openCallMeNowSurveyDialog(src) {\n    $(\'body\').append(\'<div id="chat_survey" tabindex="-1" aria-label="chat survey modal"><style>#chat_survey {background: var(--udexColorNeutralWhite);width: 400px;height: 550px;position: fixed;right: 1%;bottom: calc(58px + var(--udexSpacer24)* 2);z-index: 1000001;border-radius: 8px;overflow: hidden;box-shadow: var(--sapContent_Shadow3);}.survey_iframe {width: 100%;height: 100%;border: none;}.survey_title {background-color: var(--udexColorBlue7);color: var(--udexColorNeutralWhite);padding: var(--udexSpacer24) var(--udexSpacer16);width: 100%;display: flex;align-items: center;justify-content: space-between;}.survey_title_text {font-size: var(--udexTypographyHeadingMediumXXXSFontSize);font-weight: var(--fontWeightMedium);padding: 0 var(--udexSpacer16);}.button-group button {border: none;background: none;color: var(--udexColorNeutralWhite);}#chat_survey.collapsed{height: 77px;bottom:var(--udexSpacer16);}#chat_survey.collapsed .survey_collapse svg{transform: rotate(180deg);}#chat_survey.collapsed iframe{display:none;}@media screen and (max-width: 766px) {#chat_survey {height: 100%; bottom: 0;width: 100%;right: 0px; border-radius: 0;}.survey_collapse {display:none;}}#chat_survey:dir(rtl) {right: unset; left: 1%; }</style><script>$(".contactModule").hide();\'+\n       \'<\\/script><div class="survey_title"><span class="survey_title_text">Survey</span><div class="button-group"><button onclick="$(\\\'#chat_survey\\\').toggleClass(\\\'collapsed\\\');" class="survey_collapse" aria-label="minimize"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="min-btn"><polyline points="6 9 12 15 18 9"></polyline></svg></button><button onclick="$(\\\'#chat_survey\\\').remove();$(\\\'#chat_survey\\\').find(\\\'button, a, input, select, textarea\\\').off(\\\'keydown\\\');$(\\\'.contactModule\\\').show();" class="survey_close" aria-label="close"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="x-btn"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div></div><iframe id="callMeNowSurveyFrame" class="survey_iframe" src="\'+ src +\'"></iframe></div>\');\n    $(\'#chat_survey\').focus();\n}\n\nsetupCallMeNowSurvey();\n\nfunction checkFrequentChats() {\n    const key = "GLIS_CHAT_TIMES";\n    const milliseconds_per_day = 24 * 3600 * 1000; \n    const allowed_count = 2;\n\n    function parse_times(times) {\n        let new_times = []\n        for(const t of times) {\n           try {\n             new_times.push(parseInt(t));\n           } \n          catch {}\n        }\n\n       //console.log("parse_times", new_times);\n       return new_times;\n    }\n\n    function filter(times, now) {\n        const t = now.getTime();\n        while (times.length > 0 && t - times[0] > milliseconds_per_day) {\n          times.shift();\n        }\n\n        //console.log("filter:", times);\n    }\n\n    let times = JSON.parse(localStorage.getItem(key)) || [];\n    times = parse_times(times);\n    const now = new Date();\n    filter(times, now);\n    times.push(now.getTime());\n    localStorage.setItem(key, JSON.stringify(times));\n\n    return times.length > allowed_count;\n}\n\nfunction loadAndStartChat(server_config, extraCadData) {\n  if (checkFrequentChats()) { return; }\n  \n  const eventListener = (e) => {\n    cvcWrapper.openSCCClient("", server_config, window.sccLoaderConfig, extraCadData);\n    document.removeEventListener("CVCClientLoaded", eventListener);\n  };\n\n  document.addEventListener("CVCClientLoaded", eventListener);\n  cvcWrapper.loadCVC("", server_config, window.sccLoaderConfig);\n}\n\nfunction setupAdvisorSurvey() {\n  document.addEventListener("AdvisorChatClosedOnContactModule", (e) => openAdvisorSurvey(e));\n}\n\nfunction openAdvisorSurveyDialog(src) {\n    $(\'body\').append(\'<div id="chat_survey" tabindex="-1" aria-label="chat survey modal"><style>#chat_survey {background: var(--udexColorNeutralWhite);width: 400px;height: 550px;position: fixed;right: 1%;bottom: calc(58px + var(--udexSpacer24)* 2);z-index: 1000001;border-radius: 8px;overflow: hidden;box-shadow: var(--sapContent_Shadow3);}.survey_iframe {width: 100%;height: 100%;border: none;}.survey_title {background: linear-gradient(180deg, #5D36FF 0%, #6431FA 100%);color: var(--udexColorNeutralWhite);padding: var(--udexSpacer24) var(--udexSpacer16);width: 100%;display: flex;align-items: center;justify-content: space-between;}.survey_title_text {font-size: var(--udexTypographyHeadingMediumXXXSFontSize);font-weight: var(--fontWeightMedium);padding: 0 var(--udexSpacer16);}.button-group button {border: none;background: none;color: var(--udexColorNeutralWhite);}#chat_survey.collapsed{height: 77px;bottom:var(--udexSpacer16);}#chat_survey.collapsed .survey_collapse svg{transform: rotate(180deg);}#chat_survey.collapsed iframe{display:none;}@media screen and (max-width: 766px) {#chat_survey {height: 100%; bottom: 0;width: 100%;right: 0px; border-radius: 0;}.survey_collapse {display:none;}}#chat_survey:dir(rtl) {right: unset; left: 1%; }</style><script>$(".contactModule").hide();\'+\n       \'<\\/script><div class="survey_title"><span class="survey_title_text">Survey</span><div class="button-group"><button onclick="$(\\\'#chat_survey\\\').toggleClass(\\\'collapsed\\\');" class="survey_collapse" aria-label="minimize"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="min-btn"><polyline points="6 9 12 15 18 9"></polyline></svg></button><button onclick="$(\\\'#chat_survey\\\').remove();$(\\\'#chat_survey\\\').find(\\\'button, a, input, select, textarea\\\').off(\\\'keydown\\\');$(\\\'.contactModule\\\').show();" class="survey_close" aria-label="close"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="x-btn"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></div></div><iframe id="callMeNowSurveyFrame" class="survey_iframe" src="\'+ src +\'"></iframe></div>\');\n    $(\'#chat_survey\').focus();\n}\n\nfunction openAdvisorSurvey(e) {\n  const chatSurvey = document.getElementById("chat_survey");\n\n  if (chatSurvey) {\n    return;\n  }\n\n  const surveyData = e.detail;\n\n  const surveyId = SAP.DTM.runMode != "prod" ? "SV_bQrT3mpRCQijox0" : "SV_8H8hSHkQRUA38Lb";\n  const conversationid = surveyData.conversationId || "unknown";\n  const contact_id = "unknown";\n  const Product_Advisor_conversation_id = surveyData.interactionID || "unknown";\n  const queuename = surveyData.queueName || "unknown";\n  const queueaddress = surveyData.queueAddress || "unknown";\n  const url = window.location.href;\n  const participants = (surveyData.participants || []).join("|");\n  const agentName = getAgent(surveyData.participants || []);\n\n  let conversationDuration = 0;\n  if (surveyData.startTime && surveyData.endTime) {\n    conversationDuration = Math.ceil((new Date(surveyData.endTime) - new Date(surveyData.startTime)) / 1000);\n  }\n\n  var src = "https://sapinsights.eu.qualtrics.com/jfe/form/" + surveyId +\n    "?Site=" + encodeURIComponent(window.location.host) +\n    "&original_contact_id=" + Product_Advisor_conversation_id +\n    "&contact_id=" + contact_id +\n    "&Product_Advisor_conversation_id=" + Product_Advisor_conversation_id +\n    "&QueueName=" + encodeURIComponent(queuename) +\n    "&QueueAddress=" + encodeURIComponent(queueaddress) +\n    "&CurrentPageURL=" + encodeURIComponent(url) +\n    "&ParticipantNames=" + encodeURIComponent(participants) +\n    "&AgentChat=" + ((surveyData.participants || []).some(p => isAgentType(p)) ? "true" : "false") +\n    "&AgentName=" + encodeURIComponent(agentName) +\n    "&VisitorCountry=" + (_satellite.cookie.get("country") || "unknown");\n\n  if (surveyData.language) {\n    src += "&Q_Language=" + surveyData.language;\n  }\n\n  if (window.lastSurveyID) {\n    src += "&SurveyID=" + window.lastSurveyID;\n  }\n\n  if (conversationDuration > 0) {\n    src += "&chatStartTime=" + surveyData.startTime;\n    src += "&chatEndTime=" + surveyData.endTime;\n    src += "&chatDuration=" + conversationDuration;\n  }\n  openAdvisorSurveyDialog(src);\n}\n\nsetupAdvisorSurvey();',
