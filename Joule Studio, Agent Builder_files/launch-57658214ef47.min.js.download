unction refreshReactComponents() {\n\t\tdocument.dispatchEvent(new CustomEvent(\'global-mbox-request-fired\'));\n\t}\n\n\tvar rowLabels = (function(){\n\t\tvar id = "vecModeRowLabels";\n\t\tfunction draw(){\n\t\t\tif (!document.getElementById(id) && currentMode === mode.COMPOSE) {\n\t\t\t\t_satellite.logger.log(\'VEC: creating labels\');\n\t\t\t\tvar getContentClass = function(rowSel, rowNumber){\n\t\t\t\t\treturn rowSel + \' {content: "row \' + rowNumber + \'"}\';\n\t\t\t\t};\n\t\t\t\tvar getRowSelector = function(rowNumber){\n\t\t\t\t\treturn \'.dx-row\' + rowNumber + \':before\';\n\t\t\t\t};\n\n\t\t\t\tvar design = "{" +\n\t\t\t\t\t"position: relative;" +\n\t\t\t\t\t"background-color: #007DB8;" +\n\t\t\t\t\t"color: white;" +\n\t\t\t\t\t"border-radius: 20px 20px 0 0;" +\n\t\t\t\t\t"cursor: pointer;" +\n\t\t\t\t\t"width:100%;" +\n\t\t\t\t\t"display:block;" +\n\t\t\t\t\t"text-align:center;" +\n\t\t\t\t\t"z-index:200;" +\n\t\t\t\t\t"font-size:10px;}";\n\t\t\t\tvar rows = [];\n\t\t\t\tvar selectors = "";\n\t\t\t\tvar content = "";\n\t\t\t\tvar regExp = /dx-row(\\d{1,2})$/;\n\t\t\t\t$("div[class*=\\"dx-row\\"]").each(function(idx, elm){\n\t\t\t\t\telm.className.split(\' \').forEach(function(clsName) {\n\t\t\t\t\t\tif (regExp.test(clsName)) {\n\t\t\t\t\t\t\tvar rowNumber = regExp.exec(clsName)[1];\n\t\t\t\t\t\t\tvar rowSel = getRowSelector(rowNumber);\n\t\t\t\t\t\t\trows.push([rowSel,rowNumber]);\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t\tif (!!rows.length) {\n\t\t\t\t\trows.forEach(function(el){\n\t\t\t\t\t\tcontent += getContentClass(el[0], el[1]);\n\t\t\t\t\t\tselectors += el[0] + ",";\n\t\t\t\t\t});\n\t\t\t\t\tselectors = selectors.slice(0, selectors.length-1);\n\t\t\t\t}\n\t\t\t\t$(\'body\').append(\'<style id="\' + id + \'">\' + selectors + design + content + \'</style>\');\n\t\t\t}\n\t\t}\n\t\treturn {\n\t\t\tdraw : draw,\n\t\t\tclear :  function() {\n\t\t\t\t$(\'#\' + id).remove();\n\t\t\t}\n\t\t};\n\t})();\n\n\twindow.addEventListener(\'message\', function(event) {\n\t\tvar data = event.data;\n\t\tif (data) {\n\t\t\tvar _data = JSON.parse(data);\n\t\t\tif (_data.action && (_data.action === \'applyActions\' || _data.action === \'setContent\')) {\n\t\t\t\tif (!refreshPlanned) {\n\t\t\t\t\tsetTimeout(function () {\n\t\t\t\t\t\trefreshReactComponents();\n\t\t\t\t\t\trowLabels.draw();\n\t\t\t\t\t\trefreshPlanned = false;\n\t\t\t\t\t}, 1000);\n\t\t\t\t\trefreshPlanned = true;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (_data.action && _data.action === \'updatePageState\' && _data.pageName === \'IS_INTERACT\') {\n\t\t\t\tif (_data.pageState) {\n\t\t\t\t\trowLabels.clear();\n\t\t\t\t\tcurrentMode = mode.BROWSE;\n\t\t\t\t} else {\n\t\t\t\t\tcurrentMode = mode.COMPOSE;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t});\n})();',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL0bc17c9fdd1941f4af396ea5190cb95e",name:"00 - IsFromSAP image [PAGE_BOTTOM+1]",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:1}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){let e="e",t="v",n=18e5,r=(new Date).getTime(),a=function(){window.SAP.isFromSapImg={},window.SAP.isFromSapImg.update=function(a){let o={};1!==a&&(o[e]=r+n),o[t]=a,localStorage.setItem("_sap",JSON.stringify(o)),localStorage.removeItem("sap")}},o=_satellite.getVar("localStorage - sap (image)");if(!o)return a(),!0;if(o[e]){let t=parseInt(o[e]);if(t&&t-r<=0)return a(),!0}return!1}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"/* */\n(async function(){\n\tlet ifs = await (\n\t   new Promise(((e,t)=>{\n\t\t   const n = new Image();\n\t\t   n.onload = e;\n\t\t   n.onerror = t;\n\t\t   n.src = `https://people.wdf.sap.corp/favicon.ico?vpncheck${Date.now()}`\n\t   }))\n\t).then(() => 1).catch(() => 0);\n\twindow.SAP.isFromSapImg.update(ifs);\n})();",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL0bdc29f94007424abc053b2eb00aa6ab",name:"DL - AA - Activity Map (manual tracking) [SET+